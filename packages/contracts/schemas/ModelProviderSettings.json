{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "providers"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "providers": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "baseUrl",
          "remote",
          "models",
          "allowedByProfile"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "baseUrl": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "remote": {
            "type": "boolean"
          },
          "models": {
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "allowedByProfile": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:ModelProviderSettings",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
