{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "targetId",
    "cron",
    "timezone",
    "nextFireAt",
    "overlapPolicy",
    "budget",
    "state"
  ],
  "properties": {
    "id": {
      "pattern": "^sch_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "targetId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "cron": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "timezone": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "nextFireAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "overlapPolicy": {
      "anyOf": [
        {
          "const": "forbid",
          "type": "string"
        },
        {
          "const": "allow",
          "type": "string"
        },
        {
          "const": "replace",
          "type": "string"
        }
      ]
    },
    "budget": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "paused",
          "type": "string"
        },
        {
          "const": "archived",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:Schedule",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
