{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "projectId",
    "integrationId",
    "runId",
    "analysisId",
    "kind",
    "status",
    "issueKey",
    "signature",
    "scope",
    "uncertain",
    "payload",
    "payloadHash",
    "externalStatus",
    "externalStatusCategory",
    "syncState",
    "createdBy",
    "executedBy",
    "executedAt",
    "syncedAt",
    "failure"
  ],
  "properties": {
    "id": {
      "pattern": "^isl_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "integrationId": {
      "pattern": "^int_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "analysisId": {
      "anyOf": [
        {
          "pattern": "^ana_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "const": "link",
          "type": "string"
        },
        {
          "const": "create",
          "type": "string"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "const": "draft",
          "type": "string"
        },
        {
          "const": "previewed",
          "type": "string"
        },
        {
          "const": "executed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "issueKey": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{0,19}-[1-9][0-9]{0,9}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "testId",
        "revisionId",
        "environmentId",
        "environmentRevisionId"
      ],
      "properties": {
        "testId": {
          "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "revisionId": {
          "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "environmentId": {
          "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "environmentRevisionId": {
          "pattern": "^evr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      }
    },
    "uncertain": {
      "type": "boolean"
    },
    "payload": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title",
        "body",
        "labels",
        "link"
      ],
      "properties": {
        "title": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "body": {
          "maxLength": 8000,
          "type": "string"
        },
        "labels": {
          "maxItems": 10,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        },
        "link": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "url",
            "title"
          ],
          "properties": {
            "url": {
              "minLength": 1,
              "maxLength": 2048,
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          }
        }
      }
    },
    "payloadHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "externalStatus": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "externalStatusCategory": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "open",
              "type": "string"
            },
            {
              "const": "closed",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "syncState": {
      "anyOf": [
        {
          "const": "ok",
          "type": "string"
        },
        {
          "const": "deleted",
          "type": "string"
        },
        {
          "const": "conflict",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        }
      ]
    },
    "createdBy": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "executedBy": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "executedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "syncedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "reasonCode",
            "detail"
          ],
          "properties": {
            "reasonCode": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            "detail": {
              "maxLength": 8000,
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*:[A-Za-z0-9_-]+$": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/T0"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$ref": "#/$defs/T0"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:IssueLink",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
