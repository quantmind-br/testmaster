{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "eventId",
    "destinationRef",
    "payloadHash",
    "attempts",
    "nextAttemptAt",
    "state"
  ],
  "properties": {
    "id": {
      "pattern": "^dlv_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "eventId": {
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "destinationRef": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "payloadHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "attempts": {
      "minimum": 0,
      "type": "integer"
    },
    "nextAttemptAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "delivered",
          "type": "string"
        },
        {
          "const": "dead_letter",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Delivery",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
