{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "attemptId",
    "revisionId",
    "snapshotId",
    "manifestHash",
    "committedAt",
    "redactionPolicyHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "attemptId": {
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "revisionId": {
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "snapshotId": {
      "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "manifestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "committedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "redactionPolicyHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:BundleMeta",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
