{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "runId",
    "attemptId",
    "authProfileId",
    "challengeRef",
    "expiresAt",
    "state"
  ],
  "properties": {
    "id": {
      "pattern": "^acp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "attemptId": {
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "authProfileId": {
      "pattern": "^aup_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "challengeRef": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "completed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        },
        {
          "const": "expired",
          "type": "string"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "const": "captcha",
          "type": "string"
        },
        {
          "const": "webauthn",
          "type": "string"
        },
        {
          "const": "push",
          "type": "string"
        },
        {
          "const": "email-otp",
          "type": "string"
        },
        {
          "const": "reauthorization",
          "type": "string"
        },
        {
          "const": "adapter-unavailable",
          "type": "string"
        },
        {
          "const": "expired-state",
          "type": "string"
        }
      ]
    },
    "requestedBy": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "resolvedBy": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolvedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizationId": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizeUrl": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*:[A-Za-z0-9_-]+$": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/T0"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$ref": "#/$defs/T0"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:AuthCheckpoint",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
