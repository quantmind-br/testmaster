{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "name",
    "scopes",
    "expiresAt"
  ],
  "properties": {
    "id": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:TokenMetadata",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
