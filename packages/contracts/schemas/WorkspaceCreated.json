{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "workspace",
    "ownerPrincipalId",
    "ownerLogin",
    "ownerRecoveryToken",
    "ownerRecoveryExpiresAt"
  ],
  "properties": {
    "workspace": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "mode",
        "settingsVersion",
        "quotaPolicyId"
      ],
      "properties": {
        "id": {
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "workspaceId": {
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "const": "single-user",
              "type": "string"
            },
            {
              "const": "server",
              "type": "string"
            },
            {
              "const": "distributed",
              "type": "string"
            }
          ]
        },
        "settingsVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "quotaPolicyId": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*:[A-Za-z0-9_-]+$": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/T0"
                  }
                },
                {
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "$ref": "#/$defs/T0"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "ownerPrincipalId": {
      "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ownerLogin": {
      "pattern": "^[a-z0-9][a-z0-9._@-]{2,63}$",
      "type": "string"
    },
    "ownerRecoveryToken": {
      "pattern": "^tm_rec_[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "ownerRecoveryExpiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:WorkspaceCreated",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
