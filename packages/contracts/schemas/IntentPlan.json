{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "name",
    "type",
    "requirementRefs",
    "description",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "kind": {
      "const": "intent",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "type": {
      "anyOf": [
        {
          "const": "frontend",
          "type": "string"
        },
        {
          "const": "backend",
          "type": "string"
        },
        {
          "const": "integration",
          "type": "string"
        }
      ]
    },
    "requirementRefs": {
      "type": "array",
      "items": {
        "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "description": {
      "maxLength": 8000,
      "type": "string"
    },
    "acceptanceCriteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "maxLength": 8000,
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "minProperties": 1,
        "type": "object",
        "properties": {
          "artifactId": {
            "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "sourceRevisionId": {
            "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "snapshotId": {
            "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "relativePath": {
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "length": {
            "minimum": 0,
            "type": "integer"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "jsonPointer": {
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string"
          },
          "contentHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:IntentPlan",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
