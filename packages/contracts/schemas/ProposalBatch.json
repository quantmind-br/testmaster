{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "version",
    "projectId",
    "sourceSnapshotId",
    "state"
  ],
  "properties": {
    "id": {
      "pattern": "^pbt_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "sourceSnapshotId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "const": "proposed",
          "type": "string"
        },
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "rejected",
          "type": "string"
        },
        {
          "const": "stale",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:ProposalBatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
