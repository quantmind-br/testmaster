{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "version",
    "features",
    "sourceRevisionIds",
    "status"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "features": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "projectId",
          "stableKey",
          "requirementRefs",
          "routeRefs",
          "endpointRefs"
        ],
        "properties": {
          "id": {
            "pattern": "^fea_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "workspaceId": {
            "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "pattern": "Z$",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          },
          "projectId": {
            "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "stableKey": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "requirementRefs": {
            "type": "array",
            "items": {
              "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "routeRefs": {
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "endpointRefs": {
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "extensions": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9-]*:[A-Za-z0-9_-]+$": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/T0"
                    }
                  },
                  {
                    "type": "object",
                    "patternProperties": {
                      "^(.*)$": {
                        "$ref": "#/$defs/T0"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "sourceRevisionIds": {
      "type": "array",
      "items": {
        "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "status": {
      "anyOf": [
        {
          "const": "ready",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "needs_input",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:FeatureMap",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
