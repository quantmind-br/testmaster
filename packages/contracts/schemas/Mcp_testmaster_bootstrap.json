{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectRoot",
    "target",
    "scope",
    "mode"
  ],
  "properties": {
    "projectRoot": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Project root directory; must be inside an approved root"
    },
    "target": {
      "pattern": "^https?://[^\\s]+$",
      "maxLength": 2048,
      "type": "string",
      "description": "http(s) URL of the application under test, without credentials; it is never probed"
    },
    "scope": {
      "minItems": 1,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "codebase",
            "type": "string"
          },
          {
            "const": "diff",
            "type": "string"
          }
        ]
      },
      "description": "What the project will analyze: codebase and/or diff"
    },
    "mode": {
      "anyOf": [
        {
          "const": "replay",
          "type": "string"
        },
        {
          "const": "agent",
          "type": "string"
        }
      ],
      "description": "Execution mode of the proposed config: replay (deterministic) or agent"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_bootstrap",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
