{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "actorId",
    "reviewerId",
    "actionSet",
    "revisionHash",
    "environmentRevisionId",
    "originSet",
    "expiresAt",
    "revokedAt",
    "policyHash"
  ],
  "properties": {
    "id": {
      "pattern": "^apr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "actorId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "reviewerId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "actionSet": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "revisionHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "environmentRevisionId": {
      "pattern": "^evr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "originSet": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "revokedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "policyHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Approval",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
