{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "corpusDigest",
    "cohort",
    "trialRefs",
    "oracleVersion",
    "metrics",
    "decision",
    "limitations"
  ],
  "properties": {
    "id": {
      "pattern": "^evl_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "corpusDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "cohort": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "trialRefs": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "oracleVersion": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "number"
        }
      }
    },
    "decision": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*:[A-Za-z0-9_-]+$": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/T0"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$ref": "#/$defs/T0"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:Evaluation",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
