{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "profileId",
    "environmentId",
    "outcome",
    "reasonCode",
    "detail",
    "credentialRoles",
    "expiresAt",
    "draftsChanged",
    "checkedAt"
  ],
  "properties": {
    "profileId": {
      "pattern": "^aup_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "environmentId": {
      "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "const": "authenticated",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "checkpoint_required",
          "type": "string"
        },
        {
          "const": "blocked",
          "type": "string"
        }
      ]
    },
    "reasonCode": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "maxLength": 8000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "credentialRoles": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "expiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "draftsChanged": {
      "const": false,
      "type": "boolean"
    },
    "checkedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AuthTestLoginReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
