{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "target"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "address",
        "port"
      ],
      "properties": {
        "address": {
          "anyOf": [
            {
              "const": "127.0.0.1",
              "type": "string"
            },
            {
              "const": "::1",
              "type": "string"
            }
          ]
        },
        "port": {
          "minimum": 1,
          "maximum": 65535,
          "type": "integer"
        }
      }
    },
    "ttlSeconds": {
      "minimum": 60,
      "maximum": 3600,
      "type": "integer"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:TunnelInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
