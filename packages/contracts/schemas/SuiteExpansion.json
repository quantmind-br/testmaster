{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "suiteId",
    "suiteVersion",
    "kind",
    "resolvedAt",
    "hash",
    "members",
    "exclusions",
    "mapping",
    "requiresConfirmation",
    "dispatchable"
  ],
  "properties": {
    "suiteId": {
      "anyOf": [
        {
          "pattern": "^sui_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "suiteVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "const": "fixed",
          "type": "string"
        },
        {
          "const": "dynamic",
          "type": "string"
        }
      ]
    },
    "resolvedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "memberKey",
          "projectId",
          "projectName",
          "testId",
          "testName",
          "revisionId",
          "revisionOrdinal",
          "environmentId",
          "environmentName"
        ],
        "properties": {
          "memberKey": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "projectId": {
            "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "projectName": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "testId": {
            "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "testName": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "revisionId": {
            "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "revisionOrdinal": {
            "minimum": 1,
            "type": "integer"
          },
          "environmentId": {
            "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "environmentName": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "scope",
          "projectId",
          "testId",
          "kind",
          "reasonCode",
          "message"
        ],
        "properties": {
          "key": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "scope": {
            "anyOf": [
              {
                "const": "project",
                "type": "string"
              },
              {
                "const": "member",
                "type": "string"
              }
            ]
          },
          "projectId": {
            "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "testId": {
            "anyOf": [
              {
                "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "anyOf": [
              {
                "const": "access_denied",
                "type": "string"
              },
              {
                "const": "project_unavailable",
                "type": "string"
              },
              {
                "const": "environment_unavailable",
                "type": "string"
              },
              {
                "const": "test_unavailable",
                "type": "string"
              },
              {
                "const": "revision_unavailable",
                "type": "string"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "const": "assertions_satisfied",
                "type": "string"
              },
              {
                "const": "assertion_mismatch",
                "type": "string"
              },
              {
                "const": "assertion_timeout",
                "type": "string"
              },
              {
                "const": "missing_secret",
                "type": "string"
              },
              {
                "const": "actor_revoked",
                "type": "string"
              },
              {
                "const": "credential_revoked",
                "type": "string"
              },
              {
                "const": "manual_auth_required",
                "type": "string"
              },
              {
                "const": "auth_checkpoint_expired",
                "type": "string"
              },
              {
                "const": "upstream_failed",
                "type": "string"
              },
              {
                "const": "dependency_cycle",
                "type": "string"
              },
              {
                "const": "ambiguous_producer",
                "type": "string"
              },
              {
                "const": "unsupported_capability",
                "type": "string"
              },
              {
                "const": "security_precondition_failed",
                "type": "string"
              },
              {
                "const": "approval_required",
                "type": "string"
              },
              {
                "const": "egress_denied",
                "type": "string"
              },
              {
                "const": "worker_lost",
                "type": "string"
              },
              {
                "const": "worker_lease_expired",
                "type": "string"
              },
              {
                "const": "execution_deadline",
                "type": "string"
              },
              {
                "const": "attempt_timeout",
                "type": "string"
              },
              {
                "const": "insufficient_evidence",
                "type": "string"
              },
              {
                "const": "oracle_uncertain",
                "type": "string"
              },
              {
                "const": "retry_unsafe_external_effect",
                "type": "string"
              },
              {
                "const": "user_cancelled",
                "type": "string"
              },
              {
                "const": "deadline_cancelled",
                "type": "string"
              },
              {
                "const": "tunnel_lost",
                "type": "string"
              },
              {
                "const": "artifact_limit_exceeded",
                "type": "string"
              },
              {
                "const": "storage_unavailable",
                "type": "string"
              },
              {
                "const": "artifact_expired",
                "type": "string"
              },
              {
                "const": "redaction_failed",
                "type": "string"
              },
              {
                "const": "budget_exhausted",
                "type": "string"
              },
              {
                "const": "quota_exceeded",
                "type": "string"
              },
              {
                "const": "schedule_misfire",
                "type": "string"
              },
              {
                "const": "schedule_overlap",
                "type": "string"
              },
              {
                "const": "owner_revoked",
                "type": "string"
              },
              {
                "const": "cleanup_failed",
                "type": "string"
              },
              {
                "const": "cleanup_inconclusive",
                "type": "string"
              },
              {
                "const": "optional_step_skipped",
                "type": "string"
              },
              {
                "const": "stopped_after_failure",
                "type": "string"
              },
              {
                "const": "cancelled_before_step",
                "type": "string"
              }
            ]
          },
          "message": {
            "maxLength": 8000,
            "type": "string"
          }
        }
      }
    },
    "mapping": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "projectId",
          "projectName",
          "environmentId",
          "environmentName",
          "environmentRevisionId",
          "targetOrigins",
          "secretRefs",
          "memberCount"
        ],
        "properties": {
          "projectId": {
            "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "projectName": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "environmentId": {
            "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "environmentName": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "environmentRevisionId": {
            "pattern": "^evr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "targetOrigins": {
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "secretRefs": {
            "type": "array",
            "items": {
              "pattern": "^sec_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "memberCount": {
            "minimum": 0,
            "type": "integer"
          }
        }
      }
    },
    "requiresConfirmation": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "dispatchable": {
      "type": "boolean"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:SuiteExpansion",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
