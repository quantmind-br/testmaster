{
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "suiteId": {
      "pattern": "^sui_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Existing list to change; absent: create a list (name required)"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer",
      "description": "Current list version; required with suiteId"
    },
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "List name; required to create"
    },
    "description": {
      "maxLength": 8000,
      "type": "string",
      "description": "List description"
    },
    "memberIntervalMs": {
      "minimum": 0,
      "type": "integer",
      "description": "Minimum ms between the starts of consecutive members of a batch of this list; 0 clears; absent keeps"
    },
    "selection": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "members": {
              "minItems": 1,
              "maxItems": 500,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "testId",
                  "revisionId",
                  "environmentId"
                ],
                "properties": {
                  "testId": {
                    "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  "revisionId": {
                    "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  "environmentId": {
                    "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "projects"
          ],
          "properties": {
            "kind": {
              "const": "dynamic",
              "type": "string"
            },
            "projects": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "projectId",
                  "environmentId"
                ],
                "properties": {
                  "projectId": {
                    "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  "environmentId": {
                    "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  "filter": {
                    "additionalProperties": false,
                    "type": "object",
                    "properties": {
                      "tags": {
                        "maxItems": 32,
                        "type": "array",
                        "items": {
                          "minLength": 1,
                          "maxLength": 200,
                          "type": "string"
                        }
                      },
                      "priorities": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "const": "critical",
                              "type": "string"
                            },
                            {
                              "const": "high",
                              "type": "string"
                            },
                            {
                              "const": "normal",
                              "type": "string"
                            },
                            {
                              "const": "low",
                              "type": "string"
                            }
                          ]
                        }
                      },
                      "nameContains": {
                        "minLength": 1,
                        "maxLength": 200,
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Whole selection: fixed pinned members or dynamic project filters. Create needs selection or addMembers; with suiteId it replaces the selection"
    },
    "addMembers": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "testId",
          "revisionId",
          "environmentId"
        ],
        "properties": {
          "testId": {
            "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "revisionId": {
            "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "environmentId": {
            "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        }
      },
      "description": "Fixed members (test, revision, environment) appended to the fixed selection, or the members of a new fixed list"
    },
    "removeMembers": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "testId"
        ],
        "properties": {
          "testId": {
            "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "revisionId": {
            "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "environmentId": {
            "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        }
      },
      "description": "Members to drop from a fixed selection; revisionId and environmentId narrow the match, absent they match every member of the test"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_save_suite",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
