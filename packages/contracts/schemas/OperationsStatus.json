{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "admission",
    "claims",
    "globalAdmission",
    "isolation",
    "work",
    "backup",
    "retention"
  ],
  "properties": {
    "admission": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state",
        "reason",
        "changedBy",
        "changedAt"
      ],
      "properties": {
        "state": {
          "anyOf": [
            {
              "const": "enabled",
              "type": "string"
            },
            {
              "const": "paused",
              "type": "string"
            },
            {
              "const": "draining",
              "type": "string"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "changedBy": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "changedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "claims": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "paused",
        "reason",
        "changedBy",
        "changedAt"
      ],
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "changedBy": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "changedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "globalAdmission": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "isolation": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "isolated",
        "review"
      ],
      "properties": {
        "isolated": {
          "type": "boolean"
        },
        "review": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "work": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "activeRuns",
        "queuedJobs",
        "drained"
      ],
      "properties": {
        "activeRuns": {
          "minimum": 0,
          "type": "integer"
        },
        "queuedJobs": {
          "minimum": 0,
          "type": "integer"
        },
        "drained": {
          "type": "boolean"
        }
      }
    },
    "backup": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "configured",
        "schedule",
        "lastSuccessAt",
        "lastFailureAt"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "schedule": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastSuccessAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastFailureAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "retention": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "lastRunAt",
        "metadataWindowDays",
        "auditWindowDays",
        "runsPurged",
        "auditEventsPurged",
        "auditSummaries"
      ],
      "properties": {
        "lastRunAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadataWindowDays": {
          "minimum": 1,
          "type": "integer"
        },
        "auditWindowDays": {
          "minimum": 1,
          "type": "integer"
        },
        "runsPurged": {
          "minimum": 0,
          "type": "integer"
        },
        "auditEventsPurged": {
          "minimum": 0,
          "type": "integer"
        },
        "auditSummaries": {
          "minimum": 0,
          "type": "integer"
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:OperationsStatus",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
