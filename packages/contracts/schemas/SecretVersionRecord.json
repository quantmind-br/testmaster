{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "version",
    "event",
    "actor",
    "requestId"
  ],
  "properties": {
    "id": {
      "pattern": "^aud_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "event": {
      "anyOf": [
        {
          "const": "created",
          "type": "string"
        },
        {
          "const": "rotated",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        }
      ]
    },
    "actor": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:SecretVersionRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
