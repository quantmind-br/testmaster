{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "name",
    "allowedOrigins"
  ],
  "properties": {
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "secretRef": {
      "pattern": "^sec_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:SecretInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
