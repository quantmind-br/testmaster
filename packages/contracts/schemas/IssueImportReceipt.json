{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "integrationId",
    "provider",
    "issueKey",
    "sourceId",
    "revisionId",
    "unchanged",
    "revision",
    "checksum"
  ],
  "properties": {
    "integrationId": {
      "pattern": "^int_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "const": "jira",
          "type": "string"
        },
        {
          "const": "linear",
          "type": "string"
        }
      ]
    },
    "issueKey": {
      "pattern": "^[A-Z][A-Z0-9_]{0,19}-[1-9][0-9]{0,9}$",
      "type": "string"
    },
    "sourceId": {
      "pattern": "^src_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "revisionId": {
      "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "unchanged": {
      "type": "boolean"
    },
    "revision": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:IssueImportReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
