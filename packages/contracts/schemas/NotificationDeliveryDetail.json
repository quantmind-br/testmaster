              },
              {
                "const": "rejected",
                "type": "string"
              },
              {
                "const": "abandoned",
                "type": "string"
              }
            ]
          },
          "httpStatus": {
            "anyOf": [
              {
                "minimum": 100,
                "maximum": 599,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "uncertain": {
            "type": "boolean"
          },
          "reasonCode": {
            "anyOf": [
              {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
