        },
        {
          "const": "resource.orphaned",
          "type": "string"
        },
        {
          "const": "alert.fired",
          "type": "string"
        },
        {
          "const": "integration.test",
          "type": "string"
        }
      ]
    },
    "deliveryId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
