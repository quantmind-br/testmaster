        }
      ]
    },
    "attempts": {
      "minimum": 0,
      "type": "integer"
    },
    "nextAttemptAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcomeUncertain": {
      "type": "boolean"
    },
    "lastReasonCode": {
      "anyOf": [
