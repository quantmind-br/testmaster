      "minimum": 0,
      "maximum": 26214400,
      "type": "integer"
    },
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:UploadRequest",
