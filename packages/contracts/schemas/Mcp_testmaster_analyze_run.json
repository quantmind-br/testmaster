{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "runId"
  ],
  "properties": {
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Failed run to diagnose"
    },
    "model": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        }
      ],
      "description": "Also ask a model to read the recorded evidence: true uses the first capable model, a model id uses that model. Absent or false: rules only"
    },
    "provider": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Model provider id for the model reading; requires model (true or a model id)"
    },
    "discoveryId": {
      "pattern": "^dsc_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Discovery job to cross-reference"
    },
    "budget": {
      "additionalProperties": false,
      "description": "Optional time budget",
      "type": "object",
      "properties": {
        "deadlineMs": {
          "minimum": 1,
          "maximum": 600000,
          "type": "integer",
          "description": "Time budget in milliseconds"
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_analyze_run",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
