{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "workerId",
    "shared",
    "labels",
    "state"
  ],
  "properties": {
    "workerId": {
      "pattern": "^wrk_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "shared": {
      "type": "boolean"
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    "state": {
      "anyOf": [
        {
          "const": "enrolling",
          "type": "string"
        },
        {
          "const": "ready",
          "type": "string"
        },
        {
          "const": "draining",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        },
        {
          "const": "offline",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:RemoteWorkerIdentity",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
