{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "runId",
    "status",
    "revisionId",
    "environmentRevisionId",
    "acceptedAt",
    "links",
    "idempotencyKey"
  ],
  "properties": {
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "queued",
              "type": "string"
            },
            {
              "const": "preparing",
              "type": "string"
            },
            {
              "const": "running",
              "type": "string"
            },
            {
              "const": "collecting",
              "type": "string"
            },
            {
              "const": "analyzing",
              "type": "string"
            },
            {
              "const": "completed",
              "type": "string"
            }
          ]
        },
        {
          "anyOf": [
            {
              "const": "passed",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            },
            {
              "const": "cancelled",
              "type": "string"
            },
            {
              "const": "inconclusive",
              "type": "string"
            }
          ]
        }
      ]
    },
    "revisionId": {
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "environmentRevisionId": {
      "pattern": "^evr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "acceptedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "links": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "self",
        "events",
        "bundle"
      ],
      "properties": {
        "self": {
          "type": "string"
        },
        "events": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        }
      }
    },
    "idempotencyKey": {
      "minLength": 16,
      "maxLength": 128,
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:RunReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
