{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "manifest",
    "resources",
    "integrity",
    "nextCursor"
  ],
  "properties": {
    "manifest": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "runId",
        "attemptId",
        "revisionId",
        "snapshotId",
        "entries"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0",
          "type": "string"
        },
        "workspaceId": {
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "runId": {
          "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "attemptId": {
          "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "revisionId": {
          "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "snapshotId": {
          "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "relativePath",
              "artifactId",
              "kind",
              "mimeType",
              "sizeBytes",
              "sha256",
              "state",
              "redactionStatus"
            ],
            "properties": {
              "relativePath": {
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                "type": "string"
              },
              "artifactId": {
                "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "kind": {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              "mimeType": {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              "sizeBytes": {
                "minimum": 0,
                "type": "integer"
              },
              "sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "anyOf": [
                  {
                    "const": "available",
                    "type": "string"
                  },
                  {
                    "const": "missing",
                    "type": "string"
                  },
                  {
                    "const": "expired",
                    "type": "string"
                  },
                  {
                    "const": "partial",
                    "type": "string"
                  }
                ]
              },
              "redactionStatus": {
                "anyOf": [
                  {
                    "const": "redacted",
                    "type": "string"
                  },
                  {
                    "const": "restrictedRaw",
                    "type": "string"
                  },
                  {
                    "const": "not_applicable",
                    "type": "string"
                  }
                ]
              },
              "omissionReason": {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              }
            }
          }
        },
        "parentSnapshot": {
          "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "subset": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 8192,
        "type": "string"
      }
    },
    "integrity": {
      "anyOf": [
        {
          "const": "verified",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "invalid",
          "type": "string"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:EvidenceSummary",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
