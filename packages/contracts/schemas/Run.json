{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "testId",
    "revisionId",
    "environmentRevisionId",
    "batchId",
    "matrixCell",
    "mode",
    "phase",
    "status",
    "outcome",
    "origin",
    "gatePolicy",
    "gate",
    "cleanupOutcome",
    "analysisStatus"
  ],
  "properties": {
    "id": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "testId": {
      "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "revisionId": {
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "environmentRevisionId": {
      "pattern": "^evr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "batchId": {
      "anyOf": [
        {
          "pattern": "^bat_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "matrixCell": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "mode": {
      "anyOf": [
        {
          "const": "replay",
          "type": "string"
        },
        {
          "const": "agent",
          "type": "string"
        }
      ]
    },
    "phase": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "preparing",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "collecting",
          "type": "string"
        },
        {
          "const": "analyzing",
          "type": "string"
        },
        {
          "const": "completed",
          "type": "string"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "queued",
              "type": "string"
            },
            {
              "const": "preparing",
              "type": "string"
            },
            {
              "const": "running",
              "type": "string"
            },
            {
              "const": "collecting",
              "type": "string"
            },
            {
              "const": "analyzing",
              "type": "string"
            },
            {
              "const": "completed",
              "type": "string"
            }
          ]
        },
        {
          "anyOf": [
            {
              "const": "passed",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            },
            {
              "const": "cancelled",
              "type": "string"
            },
            {
              "const": "inconclusive",
              "type": "string"
            }
          ]
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "passed",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            },
            {
              "const": "cancelled",
              "type": "string"
            },
            {
              "const": "inconclusive",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "gatePolicy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "gate": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "not_applicable",
          "type": "string"
        }
      ]
    },
    "cleanupOutcome": {
      "anyOf": [
        {
          "const": "not_required",
          "type": "string"
        },
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "inconclusive",
          "type": "string"
        }
      ]
    },
    "analysisStatus": {
      "anyOf": [
        {
          "const": "not_requested",
          "type": "string"
        },
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "complete",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "unavailable",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:Run",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
