{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "artifactId",
    "contentHash",
    "language",
    "framework",
    "entrypoint",
    "dependencyLockRef",
    "runnerCapabilityVersion",
    "trustLevel"
  ],
  "properties": {
    "artifactId": {
      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "const": "typescript",
          "type": "string"
        },
        {
          "const": "python",
          "type": "string"
        }
      ]
    },
    "framework": {
      "anyOf": [
        {
          "const": "playwright-test",
          "type": "string"
        },
        {
          "const": "playwright-sync",
          "type": "string"
        },
        {
          "const": "playwright-async",
          "type": "string"
        },
        {
          "const": "pytest",
          "type": "string"
        },
        {
          "const": "requests",
          "type": "string"
        }
      ]
    },
    "entrypoint": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "dependencyLockRef": {
      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "runnerCapabilityVersion": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "trustLevel": {
      "anyOf": [
        {
          "const": "imported",
          "type": "string"
        },
        {
          "const": "generated",
          "type": "string"
        },
        {
          "const": "trusted",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:CodeReference",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
