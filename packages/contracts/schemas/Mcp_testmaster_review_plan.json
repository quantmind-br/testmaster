{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "batchId",
    "expectedVersion",
    "acceptIds",
    "rejectIds"
  ],
  "properties": {
    "batchId": {
      "pattern": "^pbt_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Proposal batch id"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer",
      "description": "Batch version being reviewed, for optimistic concurrency"
    },
    "acceptIds": {
      "type": "array",
      "items": {
        "pattern": "^pro_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "description": "Proposals to accept"
    },
    "rejectIds": {
      "type": "array",
      "items": {
        "pattern": "^pro_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "description": "Proposals to reject"
    },
    "reason": {
      "minLength": 1,
      "maxLength": 2000,
      "type": "string",
      "description": "Why you accept or reject; recorded on each decided proposal with the reviewer and time"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_review_plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
