{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "code",
    "projectIds"
  ],
  "properties": {
    "code": {
      "minLength": 4,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "projectIds": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:GithubManifestConversionInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
