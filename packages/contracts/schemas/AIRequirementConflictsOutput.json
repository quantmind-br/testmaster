{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "conflicts",
    "openQuestions"
  ],
  "properties": {
    "conflicts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "keys",
          "reason",
          "evidenceIds"
        ],
        "properties": {
          "keys": {
            "minItems": 2,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "reason": {
            "maxLength": 8000,
            "type": "string"
          },
          "evidenceIds": {
            "minItems": 2,
            "maxItems": 100,
            "type": "array",
            "items": {
              "pattern": "^E[1-9][0-9]{0,5}$",
              "type": "string"
            }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "maxLength": 8000,
        "type": "string"
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AIRequirementConflictsOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
