{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "requirements",
    "conflicts",
    "openQuestions"
  ],
  "properties": {
    "requirements": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "text",
          "acceptanceCriteria",
          "sourceRefs",
          "originKind",
          "confidence",
          "reason"
        ],
        "properties": {
          "key": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "text": {
            "maxLength": 8000,
            "type": "string"
          },
          "acceptanceCriteria": {
            "minItems": 1,
            "type": "array",
            "items": {
              "maxLength": 8000,
              "type": "string"
            }
          },
          "sourceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "minProperties": 1,
              "type": "object",
              "properties": {
                "artifactId": {
                  "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "sourceRevisionId": {
                  "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "snapshotId": {
                  "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "relativePath": {
                  "minLength": 1,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                  "type": "string"
                },
                "offset": {
                  "minimum": 0,
                  "type": "integer"
                },
                "length": {
                  "minimum": 0,
                  "type": "integer"
                },
                "page": {
                  "minimum": 1,
                  "type": "integer"
                },
                "jsonPointer": {
                  "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              }
            }
          },
          "originKind": {
            "anyOf": [
              {
                "const": "explicit",
                "type": "string"
              },
              {
                "const": "user_spec",
                "type": "string"
              },
              {
                "const": "inferred",
                "type": "string"
              },
              {
                "const": "observed",
                "type": "string"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "maxLength": 8000,
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "keys",
          "reason",
          "sourceRefs"
        ],
        "properties": {
          "keys": {
            "minItems": 2,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "reason": {
            "maxLength": 8000,
            "type": "string"
          },
          "sourceRefs": {
            "minItems": 2,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "minProperties": 1,
              "type": "object",
              "properties": {
                "artifactId": {
                  "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "sourceRevisionId": {
                  "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "snapshotId": {
                  "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "relativePath": {
                  "minLength": 1,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                  "type": "string"
                },
                "offset": {
                  "minimum": 0,
                  "type": "integer"
                },
                "length": {
                  "minimum": 0,
                  "type": "integer"
                },
                "page": {
                  "minimum": 1,
                  "type": "integer"
                },
                "jsonPointer": {
                  "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
                  "type": "string"
                },
                "contentHash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "maxLength": 8000,
        "type": "string"
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AIRequirementsOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
