{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "requirements",
    "conflicts",
    "openQuestions"
  ],
  "properties": {
    "requirements": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "text",
          "acceptanceCriteria",
          "evidenceIds",
          "originKind",
          "confidence",
          "reason"
        ],
        "properties": {
          "key": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "text": {
            "maxLength": 8000,
            "type": "string"
          },
          "acceptanceCriteria": {
            "minItems": 1,
            "type": "array",
            "items": {
              "maxLength": 8000,
              "type": "string"
            }
          },
          "evidenceIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "pattern": "^E[1-9][0-9]{0,5}$",
              "type": "string"
            }
          },
          "originKind": {
            "anyOf": [
              {
                "const": "explicit",
                "type": "string"
              },
              {
                "const": "user_spec",
                "type": "string"
              },
              {
                "const": "inferred",
                "type": "string"
              },
              {
                "const": "observed",
                "type": "string"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "maxLength": 8000,
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "keys",
          "reason",
          "evidenceIds"
        ],
        "properties": {
          "keys": {
            "minItems": 2,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "reason": {
            "maxLength": 8000,
            "type": "string"
          },
          "evidenceIds": {
            "minItems": 2,
            "maxItems": 100,
            "type": "array",
            "items": {
              "pattern": "^E[1-9][0-9]{0,5}$",
              "type": "string"
            }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "maxLength": 8000,
        "type": "string"
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AIRequirementsOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
