{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "workspaceId",
    "kind",
    "state",
    "requestedBy",
    "reason",
    "params",
    "result",
    "error",
    "createdAt",
    "startedAt",
    "finishedAt",
    "version"
  ],
  "properties": {
    "id": {
      "pattern": "^opr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "anyOf": [
        {
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "const": "backup",
          "type": "string"
        },
        {
          "const": "restore_verify",
          "type": "string"
        },
        {
          "const": "admission",
          "type": "string"
        },
        {
          "const": "reconcile",
          "type": "string"
        },
        {
          "const": "isolation_release",
          "type": "string"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "const": "requested",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "completed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "requestedBy": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "reason": {
      "maxLength": 8000,
      "type": "string"
    },
    "params": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            "message": {
              "maxLength": 8000,
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "startedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "finishedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:AdminOperation",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
