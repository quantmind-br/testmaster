{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "subject",
    "turns",
    "proposal"
  ],
  "properties": {
    "subject": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "const": "proposal",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            }
          ]
        },
        "id": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    "turns": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "seq",
          "role",
          "content",
          "principalId",
          "createdAt",
          "proposalId",
          "modelCallId"
        ],
        "properties": {
          "id": {
            "pattern": "^rft_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "seq": {
            "minimum": 1,
            "type": "integer"
          },
          "role": {
            "anyOf": [
              {
                "const": "user",
                "type": "string"
              },
              {
                "const": "assistant",
                "type": "string"
              }
            ]
          },
          "content": {
            "minLength": 1,
            "maxLength": 8000,
            "type": "string"
          },
          "principalId": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "pattern": "Z$",
            "type": "string"
          },
          "proposalId": {
            "anyOf": [
              {
                "pattern": "^pro_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "modelCallId": {
            "anyOf": [
              {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "proposal": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "id",
            "batchId"
          ],
          "properties": {
            "id": {
              "pattern": "^pro_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "batchId": {
              "pattern": "^pbt_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:RefinementThread",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
