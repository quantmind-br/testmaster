{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "runId",
    "number",
    "workerId",
    "seed",
    "phase",
    "startedAt",
    "endedAt",
    "outcome"
  ],
  "properties": {
    "id": {
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "number": {
      "minimum": 1,
      "type": "integer"
    },
    "workerId": {
      "anyOf": [
        {
          "pattern": "^wrk_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "type": "integer"
    },
    "phase": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "preparing",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "collecting",
          "type": "string"
        },
        {
          "const": "analyzing",
          "type": "string"
        },
        {
          "const": "completed",
          "type": "string"
        }
      ]
    },
    "startedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "endedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "passed",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            },
            {
              "const": "cancelled",
              "type": "string"
            },
            {
              "const": "inconclusive",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Attempt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
