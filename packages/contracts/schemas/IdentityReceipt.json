{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "principalId",
    "state",
    "workspaceId",
    "sessionId",
    "csrfToken",
    "expiresAt"
  ],
  "properties": {
    "principalId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "const": "authenticated",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        },
        {
          "const": "pending",
          "type": "string"
        }
      ]
    },
    "workspaceId": {
      "anyOf": [
        {
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionId": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "csrfToken": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "expiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:IdentityReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
