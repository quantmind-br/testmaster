{
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Project id; required to create a profile"
    },
    "profileId": {
      "pattern": "^aup_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Profile to update; absent: create. Needs expectedVersion"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer",
      "description": "Current version of profileId, for optimistic concurrency"
    },
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Profile name, unique in the project; required to create"
    },
    "kind": {
      "anyOf": [
        {
          "const": "form",
          "type": "string"
        },
        {
          "const": "basic",
          "type": "string"
        },
        {
          "const": "bearer",
          "type": "string"
        },
        {
          "const": "api-key",
          "type": "string"
        },
        {
          "const": "cookie",
          "type": "string"
        },
        {
          "const": "oauth",
          "type": "string"
        },
        {
          "const": "oidc",
          "type": "string"
        },
        {
          "const": "manual",
          "type": "string"
        }
      ],
      "description": "form, basic, bearer, api-key, cookie, oauth, oidc or manual; required to create, never changes"
    },
    "originBindings": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "format": "uri",
        "maxLength": 2048,
        "type": "string"
      },
      "description": "Origins the profile may authenticate against; every environment that uses it must target one of them"
    },
    "secrets": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "pattern": "^sec_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "description": "Role to secret id (testmaster_set_secret): form password, totpSeed (username too when it is a secret); basic password; bearer token; api-key key; cookie cookie. Every role except username must be a secret; a plain value is refused"
    },
    "username": {
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$",
      "description": "Username as a plain value (form, basic, oauth, oidc): stored and shown as written and NOT masked in evidence, so a username like root stays readable in DOM and logs. Use secrets.username instead to mask it (an e-mail, for example). Never both. On update, setting it replaces secrets.username",
      "type": "string"
    },
    "config": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "http": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "loginUrl",
            "contentType",
            "fields",
            "success"
          ],
          "properties": {
            "loginUrl": {
              "format": "uri",
              "maxLength": 2048,
              "description": "Login endpoint; its origin must be one of the profile's originBindings",
              "type": "string"
            },
            "contentType": {
              "description": "Request body encoding: form (urlencoded) or json",
              "anyOf": [
                {
                  "const": "form",
                  "type": "string"
                },
                {
                  "const": "json",
                  "type": "string"
                }
              ]
            },
            "fields": {
              "additionalProperties": false,
              "description": "Request field names that receive the vault values (username, password, optional otp); never the values",
              "type": "object",
              "required": [
                "username",
                "password"
              ],
              "properties": {
                "username": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "password": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "otp": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                }
              }
            },
            "staticFields": {
              "description": "Constant extra request fields (for example a client id)",
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "maxLength": 500,
                  "type": "string"
                }
              }
            },
            "success": {
              "additionalProperties": false,
              "description": "How a successful login is recognised and which credential it yields",
              "type": "object",
              "required": [
                "statusIn"
              ],
              "properties": {
                "statusIn": {
                  "minItems": 1,
                  "maxItems": 8,
                  "description": "Response statuses that mean the login succeeded",
                  "type": "array",
                  "items": {
                    "minimum": 100,
                    "maximum": 599,
                    "type": "integer"
                  }
                },
                "cookieNames": {
                  "minItems": 1,
                  "maxItems": 16,
                  "description": "Cookies kept as the session credential; omitted keeps every cookie set",
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  }
                },
                "tokenPointer": {
                  "description": "JSON pointer of a token in the response body, kept as the token credential",
                  "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
                  "type": "string"
                },
                "tokenScheme": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                }
              }
            },
            "challenge": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "statusIn": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "minimum": 100,
                    "maximum": 599,
                    "type": "integer"
                  }
                },
                "bodyContains": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "kind": {
                  "anyOf": [
                    {
                      "const": "captcha",
                      "type": "string"
                    },
                    {
                      "const": "webauthn",
                      "type": "string"
                    },
                    {
                      "const": "push",
                      "type": "string"
                    },
                    {
                      "const": "email-otp",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            "ttlSeconds": {
              "minimum": 60,
              "maximum": 86400,
              "type": "integer"
            }
          },
          "description": "form: login by HTTP request; give exactly one of http and browser"
        },
        "browser": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "additionalProperties": true,
                "type": "object",
                "properties": {}
              }
            },
            "ttlSeconds": {
              "minimum": 60,
              "maximum": 86400,
              "type": "integer"
            }
          },
          "description": "form: login in the browser; steps are plan action steps (contract PlanStep) that may reference this profile's secrets only; give exactly one of http and browser"
        },
        "challenge": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "resolution"
          ],
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "const": "captcha",
                  "type": "string"
                },
                {
                  "const": "webauthn",
                  "type": "string"
                },
                {
                  "const": "push",
                  "type": "string"
                },
                {
                  "const": "email-otp",
                  "type": "string"
                }
              ]
            },
            "resolution": {
              "anyOf": [
                {
                  "const": "storage-state",
                  "type": "string"
                },
                {
                  "const": "otp",
                  "type": "string"
                },
                {
                  "const": "retry",
                  "type": "string"
                }
              ]
            }
          },
          "description": "form (optional) or manual (required): the human-only challenge and how it is resolved"
        },
        "otp": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "const": "SHA1",
                  "type": "string"
                },
                {
                  "const": "SHA256",
                  "type": "string"
                },
                {
                  "const": "SHA512",
                  "type": "string"
                }
              ]
            },
            "digits": {
              "minimum": 6,
              "maximum": 8,
              "type": "integer"
            },
            "periodSeconds": {
              "minimum": 15,
              "maximum": 120,
              "type": "integer"
            },
            "maxFailures": {
              "minimum": 1,
              "maximum": 10,
              "type": "integer"
            },
            "windowSeconds": {
              "minimum": 60,
              "maximum": 3600,
              "type": "integer"
            }
          },
          "description": "form or oauth/oidc: one-time-code settings; needs the totpSeed secret role"
        },
        "header": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string",
          "description": "bearer, api-key or cookie: header or cookie the credential is meant for (documentation)"
        },
        "adapter": {
          "anyOf": [
            {
              "const": "generic",
              "type": "string"
            },
            {
              "const": "cognito",
              "type": "string"
            }
          ],
          "description": "oauth/oidc (required): generic or cognito; cognito needs the cognito key"
        },
        "issuer": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string",
          "description": "oauth/oidc (required): issuer URL"
        },
        "clientId": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string",
          "description": "oauth/oidc (required): client id"
        },
        "audience": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string",
          "description": "oauth/oidc: expected audience"
        },
        "scopes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "description": "oauth/oidc (required): requested scopes; each must be in allowedScopes; oidc needs openid"
        },
        "allowedScopes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "description": "oauth/oidc (required): scopes the profile may ever request"
        },
        "redirectUris": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          },
          "description": "oauth/oidc (required): registered redirect URIs"
        },
        "redirectUri": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string",
          "description": "oauth/oidc (required): the redirect URI in use; one of redirectUris"
        },
        "endpoints": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "authorization": {
              "format": "uri",
              "maxLength": 2048,
              "type": "string"
            },
            "token": {
              "format": "uri",
              "maxLength": 2048,
              "type": "string"
            },
            "jwks": {
              "format": "uri",
              "maxLength": 2048,
              "type": "string"
            },
            "revocation": {
              "format": "uri",
              "maxLength": 2048,
              "type": "string"
            }
          },
          "description": "oauth/oidc: explicit authorization, token, jwks and revocation endpoints"
        },
        "cognito": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "region"
          ],
          "properties": {
            "region": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            "endpoint": {
              "format": "uri",
              "maxLength": 2048,
              "type": "string"
            },
            "userPoolId": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "description": "oauth/oidc with adapter cognito: region, endpoint and user pool"
        },
        "tokenScheme": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string",
          "description": "oauth/oidc: prefix of the stored access token, default Bearer"
        },
        "ttlSeconds": {
          "minimum": 60,
          "maximum": 86400,
          "type": "integer",
          "description": "manual: lifetime of the supplied session in seconds"
        }
      },
      "description": "Keys of the kind: form {http|browser}; basic, bearer, api-key, cookie: {} (header optional for the last three); oauth/oidc adapter, issuer, clientId, scopes, allowedScopes, redirectUris, redirectUri; manual challenge. Each key names its kinds"
    },
    "refreshPolicy": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "skewSeconds": {
          "minimum": 0,
          "maximum": 600,
          "type": "integer"
        },
        "maxRefreshesPerHour": {
          "minimum": 1,
          "maximum": 60,
          "type": "integer"
        },
        "cooldownSeconds": {
          "minimum": 0,
          "maximum": 3600,
          "type": "integer"
        },
        "maxConsecutiveFailures": {
          "minimum": 1,
          "maximum": 10,
          "type": "integer"
        },
        "stateTtlSeconds": {
          "minimum": 60,
          "maximum": 86400,
          "type": "integer"
        }
      },
      "description": "Session refresh limits; absent fields keep their defaults"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_save_auth_profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
