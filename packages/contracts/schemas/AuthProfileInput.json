{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "name",
    "kind",
    "originBindings",
    "secrets",
    "config"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "kind": {
      "anyOf": [
        {
          "const": "form",
          "type": "string"
        },
        {
          "const": "basic",
          "type": "string"
        },
        {
          "const": "bearer",
          "type": "string"
        },
        {
          "const": "api-key",
          "type": "string"
        },
        {
          "const": "cookie",
          "type": "string"
        },
        {
          "const": "oauth",
          "type": "string"
        },
        {
          "const": "oidc",
          "type": "string"
        },
        {
          "const": "manual",
          "type": "string"
        }
      ]
    },
    "originBindings": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "format": "uri",
        "maxLength": 2048,
        "type": "string"
      }
    },
    "secrets": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "pattern": "^sec_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      }
    },
    "username": {
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$",
      "description": "Plain username, stored and shown as written and NOT masked in evidence; a secret username (secrets.username) is masked everywhere. Give one of the two, never both",
      "type": "string"
    },
    "config": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "refreshPolicy": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "skewSeconds": {
          "minimum": 0,
          "maximum": 600,
          "type": "integer"
        },
        "maxRefreshesPerHour": {
          "minimum": 1,
          "maximum": 60,
          "type": "integer"
        },
        "cooldownSeconds": {
          "minimum": 0,
          "maximum": 3600,
          "type": "integer"
        },
        "maxConsecutiveFailures": {
          "minimum": 1,
          "maximum": 10,
          "type": "integer"
        },
        "stateTtlSeconds": {
          "minimum": 60,
          "maximum": 86400,
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:AuthProfileInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
