{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "createdAt",
    "files",
    "databaseVersion",
    "secretIncluded"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "relativePath",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "relativePath": {
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "sizeBytes": {
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    "databaseVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "secretIncluded": {
      "const": false,
      "type": "boolean"
    },
    "keyIds": {
      "type": "array",
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      }
    },
    "configDigests": {
      "type": "array",
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      }
    },
    "missingObjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engine": {
      "anyOf": [
        {
          "const": "sqlite",
          "type": "string"
        },
        {
          "const": "postgres",
          "type": "string"
        }
      ]
    },
    "backupId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "encryption": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "algorithm",
        "keyId",
        "chunkBytes"
      ],
      "properties": {
        "algorithm": {
          "const": "aes-256-gcm-chunked",
          "type": "string"
        },
        "keyId": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "chunkBytes": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "mac": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:BackupManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
