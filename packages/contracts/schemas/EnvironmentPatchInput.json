{
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "baseUrl": {
      "format": "uri",
      "type": "string"
    },
    "networkProfile": {
      "anyOf": [
        {
          "const": "public",
          "type": "string"
        },
        {
          "const": "private",
          "type": "string"
        },
        {
          "const": "local-loopback",
          "type": "string"
        }
      ]
    },
    "additionalOrigins": {
      "maxItems": 32,
      "description": "Exact extra origins (scheme, host, port; no path, query, credentials or wildcard) page subrequests may reach. Replaces the previous list; [] clears it. They never receive credentials and are not target origins.",
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "ignoredOrigins": {
      "maxItems": 32,
      "description": "Exact origins (scheme, host, port; no path, query, credentials or wildcard) whose requests are aborted and recorded, never failing the run and never reaching the network. Disjoint from the target and additional origins. Replaces the previous list; [] clears it.",
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "authRefs": {
      "type": "array",
      "items": {
        "pattern": "^aup_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "production": {
      "type": "boolean"
    },
    "serverLog": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "container"
          ],
          "properties": {
            "kind": {
              "const": "docker",
              "type": "string"
            },
            "container": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{1,127}$",
              "description": "Docker container name or id (docker's name grammar)",
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "workerSelector": {
      "description": "Operator labels a worker must carry to claim this environment's Runs (for example a private network pool). Replaces the previous selector; {} clears it.",
      "maxProperties": 16,
      "additionalProperties": false,
      "type": "object",
      "patternProperties": {
        "^(?!(?:name|pid|architecture|os|capacity|actions|slots)$)[a-z][a-z0-9._-]{0,62}$": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:EnvironmentPatchInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
