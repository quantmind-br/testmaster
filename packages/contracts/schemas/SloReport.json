{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "generatedAt",
    "indicators"
  ],
  "properties": {
    "generatedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "indicators": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:SloReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
