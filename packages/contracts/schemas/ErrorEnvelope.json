{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "error": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "details",
        "nextActions"
      ],
      "properties": {
        "code": {
          "anyOf": [
            {
              "const": "INVALID_ARGUMENT",
              "type": "string"
            },
            {
              "const": "UNAUTHENTICATED",
              "type": "string"
            },
            {
              "const": "FORBIDDEN",
              "type": "string"
            },
            {
              "const": "NOT_FOUND",
              "type": "string"
            },
            {
              "const": "IDEMPOTENCY_CONFLICT",
              "type": "string"
            },
            {
              "const": "RUN_IN_FLIGHT",
              "type": "string"
            },
            {
              "const": "REVISION_CONFLICT",
              "type": "string"
            },
            {
              "const": "PRECONDITION_REQUIRED",
              "type": "string"
            },
            {
              "const": "PRECONDITION_FAILED",
              "type": "string"
            },
            {
              "const": "CAPABILITY_UNAVAILABLE",
              "type": "string"
            },
            {
              "const": "POLICY_DENIED",
              "type": "string"
            },
            {
              "const": "PAYLOAD_TOO_LARGE",
              "type": "string"
            },
            {
              "const": "RATE_LIMITED",
              "type": "string"
            },
            {
              "const": "QUOTA_EXCEEDED",
              "type": "string"
            },
            {
              "const": "ARTIFACT_EXPIRED",
              "type": "string"
            },
            {
              "const": "CURSOR_EXPIRED",
              "type": "string"
            },
            {
              "const": "UNAVAILABLE",
              "type": "string"
            },
            {
              "const": "UPSTREAM_TIMEOUT",
              "type": "string"
            },
            {
              "const": "INTERNAL",
              "type": "string"
            }
          ]
        },
        "message": {
          "maxLength": 8000,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/T0"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$ref": "#/$defs/T0"
                }
              }
            }
          ]
        },
        "nextActions": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "parameters"
            ],
            "properties": {
              "action": {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              "parameters": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/T0"
                    }
                  },
                  {
                    "type": "object",
                    "patternProperties": {
                      "^(.*)$": {
                        "$ref": "#/$defs/T0"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:ErrorEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
