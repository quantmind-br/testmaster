{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "actor",
    "action",
    "resourceId",
    "requestId",
    "beforeHash",
    "afterHash",
    "timestamp"
  ],
  "properties": {
    "id": {
      "pattern": "^aud_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "actor": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "action": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "resourceId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "beforeHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "afterHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AuditEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
