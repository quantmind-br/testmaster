{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "failureKind",
    "hypotheses",
    "recommendedAction",
    "fixTargetHandle",
    "limitations",
    "nextSteps",
    "evidenceGaps"
  ],
  "properties": {
    "failureKind": {
      "anyOf": [
        {
          "const": "product_bug",
          "type": "string"
        },
        {
          "const": "test_fragility",
          "type": "string"
        },
        {
          "const": "environment",
          "type": "string"
        },
        {
          "const": "contract_violation",
          "type": "string"
        },
        {
          "const": "security_policy",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    },
    "hypotheses": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "supports",
          "contradicts",
          "confidence"
        ],
        "properties": {
          "text": {
            "maxLength": 8000,
            "type": "string"
          },
          "supports": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "pattern": "^E[1-9][0-9]{0,5}$",
              "type": "string"
            }
          },
          "contradicts": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "pattern": "^E[1-9][0-9]{0,5}$",
              "type": "string"
            }
          },
          "confidence": {
            "minimum": 0,
            "maximum": 1,
            "type": "number"
          }
        }
      }
    },
    "recommendedAction": {
      "anyOf": [
        {
          "const": "fix_product",
          "type": "string"
        },
        {
          "const": "fix_test",
          "type": "string"
        },
        {
          "const": "fix_environment",
          "type": "string"
        },
        {
          "const": "review_contract",
          "type": "string"
        },
        {
          "const": "collect_more_evidence",
          "type": "string"
        }
      ]
    },
    "fixTargetHandle": {
      "anyOf": [
        {
          "pattern": "^E[1-9][0-9]{0,5}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "nextSteps": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "evidence"
        ],
        "properties": {
          "action": {
            "anyOf": [
              {
                "const": "collect_more_evidence",
                "type": "string"
              },
              {
                "const": "restore_environment",
                "type": "string"
              },
              {
                "const": "review_security_precondition",
                "type": "string"
              },
              {
                "const": "compare_contract",
                "type": "string"
              },
              {
                "const": "inspect_persistence",
                "type": "string"
              },
              {
                "const": "compare_requirement",
                "type": "string"
              },
              {
                "const": "review_healing_proposal",
                "type": "string"
              },
              {
                "const": "inspect_locator_candidates",
                "type": "string"
              }
            ]
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "pattern": "^E[1-9][0-9]{0,5}$",
              "type": "string"
            }
          }
        }
      }
    },
    "evidenceGaps": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "requirementAgreement": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "requirementId",
            "criterionIndex"
          ],
          "properties": {
            "requirementId": {
              "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "criterionIndex": {
              "minimum": 0,
              "maximum": 99,
              "type": "integer"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AIAnalysisOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
