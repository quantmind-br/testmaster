{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "sourceRevisionIds"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Project id"
    },
    "sourceRevisionIds": {
      "type": "array",
      "items": {
        "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "description": "Source revisions to normalize"
    },
    "provider": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Model provider id; absent: the first allowed provider with a capable model"
    },
    "model": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Model id from the project's profiles; defaults to the first capable one"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_normalize_requirements",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
