{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "requiredApprovers",
    "separationOfDuties",
    "version",
    "updatedAt",
    "updatedBy"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "requiredApprovers": {
      "anyOf": [
        {
          "const": 1,
          "type": "number"
        },
        {
          "const": 2,
          "type": "number"
        }
      ]
    },
    "separationOfDuties": {
      "type": "boolean"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "updatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedBy": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:ApprovalPolicy",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
