{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiKeySecretRef",
    "teamId",
    "teamKey"
  ],
  "properties": {
    "apiUrl": {
      "minLength": 1,
      "maxLength": 2048,
      "type": "string"
    },
    "apiKeySecretRef": {
      "pattern": "^sec_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "teamId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "teamKey": {
      "pattern": "^[A-Z][A-Z0-9_]{0,19}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:LinearSettings",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
