{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "principalId",
    "createdAt",
    "lastSeenAt",
    "expiresAt",
    "idleExpiresAt",
    "revokedAt",
    "current"
  ],
  "properties": {
    "id": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "principalId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "lastSeenAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "idleExpiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "revokedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "current": {
      "type": "boolean"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:SessionMetadata",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
