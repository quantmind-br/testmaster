{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "version",
    "projectId",
    "text",
    "sourceRefs",
    "validFrom",
    "expiresAt",
    "approval",
    "tombstoneAt"
  ],
  "properties": {
    "id": {
      "pattern": "^mry_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "text": {
      "maxLength": 8000,
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "minProperties": 1,
        "type": "object",
        "properties": {
          "artifactId": {
            "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "sourceRevisionId": {
            "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "snapshotId": {
            "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "relativePath": {
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "length": {
            "minimum": 0,
            "type": "integer"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "jsonPointer": {
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string"
          },
          "contentHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    "validFrom": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "expiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "pattern": "^apr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "tombstoneAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:MemoryEntry",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
