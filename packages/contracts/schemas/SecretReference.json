{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "workspaceId",
    "provider",
    "locator",
    "secretVersion",
    "allowedOrigins"
  ],
  "properties": {
    "id": {
      "pattern": "^sec_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "provider": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "locator": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "secretVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "revokedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:SecretReference",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
