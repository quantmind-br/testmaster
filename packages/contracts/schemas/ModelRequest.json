{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "purpose",
    "provider",
    "model",
    "promptVersion",
    "schemaVersion",
    "inputRefs",
    "responseSchema",
    "policyHash"
  ],
  "properties": {
    "purpose": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "promptVersion": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "schemaVersion": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "minProperties": 1,
        "dependentRequired": {
          "attemptId": [
            "runId"
          ],
          "stepId": [
            "runId",
            "attemptId"
          ],
          "observationSeq": [
            "runId"
          ]
        },
        "type": "object",
        "properties": {
          "artifactId": {
            "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "sourceRevisionId": {
            "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "snapshotId": {
            "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "relativePath": {
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "length": {
            "minimum": 0,
            "type": "integer"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "jsonPointer": {
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string"
          },
          "contentHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "runId": {
            "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "attemptId": {
            "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "stepId": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "observationSeq": {
            "minimum": 0,
            "type": "integer"
          }
        }
      }
    },
    "responseSchema": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "reasoningEffort": {
      "anyOf": [
        {
          "const": "low",
          "type": "string"
        },
        {
          "const": "medium",
          "type": "string"
        },
        {
          "const": "high",
          "type": "string"
        }
      ]
    },
    "policyHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:ModelRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
