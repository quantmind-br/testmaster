{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "leaseId",
    "state",
    "version"
  ],
  "properties": {
    "leaseId": {
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "const": "ready",
          "type": "string"
        },
        {
          "const": "draining",
          "type": "string"
        },
        {
          "const": "offline",
          "type": "string"
        }
      ]
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:HeartbeatInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
