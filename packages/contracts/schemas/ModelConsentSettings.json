{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "dataClasses",
    "providers"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "dataClasses": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "anyOf": [
              {
                "const": "documents",
                "type": "string"
              },
              {
                "const": "code_summary",
                "type": "string"
              },
              {
                "const": "dom",
                "type": "string"
              },
              {
                "const": "requirements",
                "type": "string"
              },
              {
                "const": "plans",
                "type": "string"
              },
              {
                "const": "execution_evidence",
                "type": "string"
              }
            ]
          },
          "description": {
            "maxLength": 8000,
            "type": "string"
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "baseUrl",
          "remote",
          "models",
          "allowedByProfile",
          "consent"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "baseUrl": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "remote": {
            "type": "boolean"
          },
          "models": {
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          },
          "allowedByProfile": {
            "type": "boolean"
          },
          "consent": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "dataClasses",
                  "allowUnknownCost",
                  "grantedBy",
                  "grantedAt",
                  "revokedAt"
                ],
                "properties": {
                  "dataClasses": {
                    "type": "array",
                    "items": {
                      "minLength": 1,
                      "maxLength": 200,
                      "type": "string"
                    }
                  },
                  "allowUnknownCost": {
                    "type": "boolean"
                  },
                  "grantedBy": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  },
                  "grantedAt": {
                    "format": "date-time",
                    "pattern": "Z$",
                    "type": "string"
                  },
                  "revokedAt": {
                    "anyOf": [
                      {
                        "format": "date-time",
                        "pattern": "Z$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:ModelConsentSettings",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
