{
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "originBindings": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "format": "uri",
        "maxLength": 2048,
        "type": "string"
      }
    },
    "secrets": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "pattern": "^sec_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      }
    },
    "config": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "refreshPolicy": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "skewSeconds": {
          "minimum": 0,
          "maximum": 600,
          "type": "integer"
        },
        "maxRefreshesPerHour": {
          "minimum": 1,
          "maximum": 60,
          "type": "integer"
        },
        "cooldownSeconds": {
          "minimum": 0,
          "maximum": 3600,
          "type": "integer"
        },
        "maxConsecutiveFailures": {
          "minimum": 1,
          "maximum": 10,
          "type": "integer"
        },
        "stateTtlSeconds": {
          "minimum": 60,
          "maximum": 86400,
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:AuthProfilePatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
