{
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "projectId": {
      "anyOf": [
        {
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "includeDrafts": {
      "type": "boolean"
    },
    "forkPolicy": {
      "anyOf": [
        {
          "const": "deny",
          "type": "string"
        },
        {
          "const": "fixture-only",
          "type": "string"
        }
      ]
    },
    "selection": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "testIds"
          ],
          "properties": {
            "kind": {
              "const": "tests",
              "type": "string"
            },
            "testIds": {
              "minItems": 1,
              "maxItems": 200,
              "type": "array",
              "items": {
                "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "baseEnvironmentId": {
      "anyOf": [
        {
          "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixtureEnvironmentId": {
      "anyOf": [
        {
          "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "preview": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "const": "github-deployments",
              "type": "string"
            },
            {
              "const": "manual",
              "type": "string"
            }
          ]
        },
        "environmentPattern": {
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9*?._/ -]+$",
          "type": "string"
        },
        "timeoutMs": {
          "minimum": 1000,
          "maximum": 86400000,
          "type": "integer"
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:GithubRepositoryPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
