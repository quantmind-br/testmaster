{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "batchId",
    "environmentId"
  ],
  "properties": {
    "batchId": {
      "pattern": "^pbt_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Proposal batch id"
    },
    "environmentId": {
      "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Environment to replay the proposals' plans against"
    },
    "proposalIds": {
      "minItems": 1,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^pro_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "description": "Proposals of the batch to try; absent: every proposal of the batch"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_trial_plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
