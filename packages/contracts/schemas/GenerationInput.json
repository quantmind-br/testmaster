{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "inputRefs",
    "scope",
    "budget"
  ],
  "properties": {
    "inputRefs": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "minProperties": 1,
        "dependentRequired": {
          "attemptId": [
            "runId"
          ],
          "stepId": [
            "runId",
            "attemptId"
          ],
          "observationSeq": [
            "runId"
          ]
        },
        "type": "object",
        "properties": {
          "artifactId": {
            "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "sourceRevisionId": {
            "pattern": "^svr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "snapshotId": {
            "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "relativePath": {
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "length": {
            "minimum": 0,
            "type": "integer"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "jsonPointer": {
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
            "type": "string"
          },
          "contentHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "runId": {
            "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "attemptId": {
            "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "stepId": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "observationSeq": {
            "minimum": 0,
            "type": "integer"
          }
        }
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "budget": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:GenerationInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
