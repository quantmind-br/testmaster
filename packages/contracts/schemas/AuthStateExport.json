{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "profileId",
    "storageState",
    "sha256",
    "capturedAt",
    "expiresAt",
    "exportExpiresAt"
  ],
  "properties": {
    "profileId": {
      "pattern": "^aup_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "storageState": {
      "maxLength": 262144,
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "capturedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "exportExpiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AuthStateExport",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
