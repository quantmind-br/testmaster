              "type": "string"
            },
            {
              "const": "credential_revoked",
              "type": "string"
            },
            {
              "const": "manual_auth_required",
              "type": "string"
            },
            {
              "const": "auth_checkpoint_expired",
              "type": "string"
            },
            {
              "const": "upstream_failed",
              "type": "string"
            },
            {
              "const": "dependency_cycle",
              "type": "string"
            },
            {
              "const": "ambiguous_producer",
              "type": "string"
            },
            {
              "const": "unsupported_capability",
              "type": "string"
            },
            {
              "const": "security_precondition_failed",
              "type": "string"
            },
            {
              "const": "approval_required",
              "type": "string"
            },
            {
              "const": "egress_denied",
              "type": "string"
            },
            {
              "const": "worker_lost",
              "type": "string"
            },
            {
              "const": "worker_lease_expired",
              "type": "string"
            },
            {
              "const": "execution_deadline",
              "type": "string"
            },
            {
              "const": "attempt_timeout",
              "type": "string"
            },
            {
              "const": "insufficient_evidence",
              "type": "string"
            },
            {
              "const": "oracle_uncertain",
              "type": "string"
            },
            {
              "const": "retry_unsafe_external_effect",
              "type": "string"
            },
            {
              "const": "user_cancelled",
              "type": "string"
            },
            {
              "const": "deadline_cancelled",
              "type": "string"
            },
            {
              "const": "tunnel_lost",
              "type": "string"
            },
            {
              "const": "artifact_limit_exceeded",
              "type": "string"
