              "type": "string"
            },
            {
              "const": "budget_exhausted",
              "type": "string"
            },
            {
              "const": "quota_exceeded",
              "type": "string"
            },
            {
              "const": "schedule_misfire",
              "type": "string"
            },
            {
              "const": "schedule_overlap",
              "type": "string"
            },
            {
              "const": "owner_revoked",
              "type": "string"
