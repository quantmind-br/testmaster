{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "resourceId",
    "operationId",
    "state",
    "attemptId"
  ],
  "properties": {
    "resourceId": {
      "pattern": "^res_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "operationId": {
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "cleaned",
          "type": "string"
        },
        {
          "const": "cleanup_failed",
          "type": "string"
        },
        {
          "const": "uncertain",
          "type": "string"
        }
      ]
    },
    "attemptId": {
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "bundleDir": {
