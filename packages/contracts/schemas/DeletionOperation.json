{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "resourceRefs",
    "requestedBy",
    "revokedAt",
    "physicalState",
    "backupHolds",
    "errors"
  ],
  "properties": {
    "id": {
      "pattern": "^del_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "resourceRefs": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "requestedBy": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "revokedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "physicalState": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "completed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "backupHolds": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:DeletionOperation",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
