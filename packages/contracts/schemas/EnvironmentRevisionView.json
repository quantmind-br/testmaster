{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "targetOrigins",
    "additionalOrigins",
    "ignoredOrigins",
    "networkProfile",
    "authProfileRefs",
    "locale",
    "timezone",
    "production",
    "serverLog",
    "workerSelector"
  ],
  "properties": {
    "id": {
      "pattern": "^evr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "targetOrigins": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "additionalOrigins": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "ignoredOrigins": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "networkProfile": {
      "anyOf": [
        {
          "const": "public",
          "type": "string"
        },
        {
          "const": "private",
          "type": "string"
        },
        {
          "const": "local-loopback",
          "type": "string"
        }
      ]
    },
    "authProfileRefs": {
      "type": "array",
      "items": {
        "pattern": "^aup_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "locale": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "timezone": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "production": {
      "type": "boolean"
    },
    "serverLog": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "container"
          ],
          "properties": {
            "kind": {
              "const": "docker",
              "type": "string"
            },
            "container": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{1,127}$",
              "description": "Docker container name or id (docker's name grammar)",
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "workerSelector": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:EnvironmentRevisionView",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
