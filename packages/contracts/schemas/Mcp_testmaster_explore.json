{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "envId",
    "featureIds",
    "budget"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Project id"
    },
    "envId": {
      "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Environment to explore"
    },
    "featureIds": {
      "type": "array",
      "items": {
        "pattern": "^fea_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "description": "Features to explore; empty with jobId resumes that job"
    },
    "budget": {
      "additionalProperties": false,
      "description": "Exploration budget; modelCalls must not exceed steps",
      "type": "object",
      "required": [
        "steps",
        "modelCalls",
        "timeMs"
      ],
      "properties": {
        "steps": {
          "minimum": 1,
          "maximum": 100,
          "type": "integer",
          "description": "Browser steps, 1..100"
        },
        "modelCalls": {
          "minimum": 1,
          "maximum": 100,
          "type": "integer",
          "description": "Model calls, 1..steps"
        },
        "timeMs": {
          "minimum": 1000,
          "maximum": 300000,
          "type": "integer",
          "description": "Time budget in ms, 1000..300000"
        }
      }
    },
    "provider": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Model provider id for action resolution; absent: first allowed provider"
    },
    "model": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Model id for action resolution; absent: the provider's first capable model"
    },
    "mutationActions": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "additionalProperties": true,
        "type": "object",
        "properties": {}
      },
      "description": "Approved form steps (plan Step objects: click, fill, press, select, check, uncheck; each with a locator) the controller may select when one matches an observed control; max 20, refused in production environments. Without it a form-only page offers the model nothing to choose"
    },
    "jobId": {
      "pattern": "^dsc_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Existing exploration job to resume or retry"
    },
    "wait": {
      "type": "boolean",
      "description": "Block until the job ends instead of returning its id"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_explore",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
