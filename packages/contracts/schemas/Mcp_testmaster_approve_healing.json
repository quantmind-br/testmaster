{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "proposalId",
    "expectedVersion"
  ],
  "properties": {
    "proposalId": {
      "pattern": "^hea_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Healing proposal id"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer",
      "description": "approval.expectedVersion from testmaster_review_healing"
    },
    "reason": {
      "minLength": 1,
      "maxLength": 2000,
      "type": "string",
      "description": "Why you approve; recorded on the proposal with the reviewer and time (testmaster_review_healing shows it)"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_approve_healing",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
