{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "runId"
  ],
  "properties": {
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Run id"
    },
    "attemptId": {
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Attempt; defaults to the last one"
    },
    "failedOnly": {
      "type": "boolean",
      "description": "Only entries of failed steps"
    },
    "maxBytes": {
      "minimum": 1,
      "maximum": 67108864,
      "type": "integer",
      "description": "Page size bound in bytes"
    },
    "cursor": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string",
      "description": "nextCursor of the previous page"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_get_evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
