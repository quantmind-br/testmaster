{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "mode"
  ],
  "properties": {
    "testIds": {
      "type": "array",
      "items": {
        "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "description": "Tests to run; needs environmentId"
    },
    "suiteId": {
      "pattern": "^sui_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "List to run (replay only) instead of testIds"
    },
    "environmentId": {
      "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Environment for testIds; lists carry their own"
    },
    "mode": {
      "anyOf": [
        {
          "const": "replay",
          "type": "string"
        },
        {
          "const": "agent",
          "type": "string"
        }
      ],
      "description": "replay (deterministic) or agent; lists run in replay only"
    },
    "confirmedExclusions": {
      "maxItems": 600,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      },
      "description": "Lists only: exclusion keys accepted so the rest runs"
    },
    "limits": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "executionTimeoutMs": {
          "minimum": 1,
          "maximum": 7200000,
          "default": 1800000,
          "type": "integer"
        },
        "attemptTimeoutMs": {
          "minimum": 1,
          "maximum": 900000,
          "default": 300000,
          "type": "integer"
        },
        "stepTimeoutMs": {
          "minimum": 1,
          "type": "integer"
        },
        "networkRequestTimeoutMs": {
          "minimum": 1,
          "type": "integer"
        },
        "preparationTimeoutMs": {
          "minimum": 1,
          "type": "integer"
        },
        "collectionGraceMs": {
          "minimum": 0,
          "type": "integer"
        },
        "analysisGraceMs": {
          "minimum": 0,
          "type": "integer"
        },
        "maxAttempts": {
          "minimum": 1,
          "maximum": 2,
          "default": 2,
          "type": "integer"
        },
        "bodyBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "artifactBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "attemptArtifactBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "logBytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "description": "Per-run execution limits"
    },
    "jobId": {
      "pattern": "^bat_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Existing batch to re-read or wait on instead of admitting"
    },
    "idempotencyKey": {
      "minLength": 16,
      "maxLength": 128,
      "type": "string",
      "description": "Makes a retried admission return the same batch"
    },
    "wait": {
      "type": "boolean",
      "description": "Block until every run completes"
    },
    "timeoutMs": {
      "minimum": 1,
      "maximum": 6000000,
      "type": "integer",
      "description": "Wait deadline in ms; runs continue after it"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_run_tests",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
