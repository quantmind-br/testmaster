{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "owner",
    "runbook",
    "description",
    "threshold"
  ],
  "properties": {
    "id": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "const": "critical",
          "type": "string"
        },
        {
          "const": "high",
          "type": "string"
        },
        {
          "const": "medium",
          "type": "string"
        }
      ]
    },
    "owner": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "runbook": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "description": {
      "maxLength": 8000,
      "type": "string"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:AlertRuleView",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
