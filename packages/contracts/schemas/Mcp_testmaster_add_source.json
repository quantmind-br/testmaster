{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "path",
    "role"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Project id"
    },
    "path": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Source file inside an approved root: PRD (markdown, text, JSON, PDF), OpenAPI, GraphQL or Postman"
    },
    "role": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "What the source is, e.g. prd or api; role api-spec reads as OpenAPI unless format says otherwise"
    },
    "name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string",
      "description": "Display name; defaults to the file name"
    },
    "format": {
      "anyOf": [
        {
          "const": "markdown",
          "type": "string"
        },
        {
          "const": "text",
          "type": "string"
        },
        {
          "const": "prd-json",
          "type": "string"
        },
        {
          "const": "pdf",
          "type": "string"
        },
        {
          "const": "openapi",
          "type": "string"
        },
        {
          "const": "graphql",
          "type": "string"
        },
        {
          "const": "postman",
          "type": "string"
        }
      ],
      "description": "Parser to use; absent: chosen from the extension and role"
    },
    "sourceId": {
      "pattern": "^src_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string",
      "description": "Existing source to add a new revision to; needs expectedVersion"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer",
      "description": "Current version of sourceId, for optimistic concurrency"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:Mcp_testmaster_add_source",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
