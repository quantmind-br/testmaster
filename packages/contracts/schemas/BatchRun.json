{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "selectionSnapshot",
    "requestedCount",
    "memberRuns",
    "rejectedMembers",
    "commit",
    "aggregate"
  ],
  "properties": {
    "id": {
      "pattern": "^bat_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "selectionSnapshot": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    },
    "requestedCount": {
      "minimum": 0,
      "type": "integer"
    },
    "memberRuns": {
      "type": "array",
      "items": {
        "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "rejectedMembers": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "memberKey",
          "reasonCode"
        ],
        "properties": {
          "memberKey": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "reasonCode": {
            "anyOf": [
              {
                "const": "assertions_satisfied",
                "type": "string"
              },
              {
                "const": "assertion_mismatch",
                "type": "string"
              },
              {
                "const": "assertion_timeout",
                "type": "string"
              },
              {
                "const": "missing_secret",
                "type": "string"
              },
              {
                "const": "credential_revoked",
                "type": "string"
              },
              {
                "const": "manual_auth_required",
                "type": "string"
              },
              {
                "const": "auth_checkpoint_expired",
                "type": "string"
              },
              {
                "const": "upstream_failed",
                "type": "string"
              },
              {
                "const": "dependency_cycle",
                "type": "string"
              },
              {
                "const": "ambiguous_producer",
                "type": "string"
              },
              {
                "const": "unsupported_capability",
                "type": "string"
              },
              {
                "const": "security_precondition_failed",
                "type": "string"
              },
              {
                "const": "approval_required",
                "type": "string"
              },
              {
                "const": "egress_denied",
                "type": "string"
              },
              {
                "const": "worker_lost",
                "type": "string"
              },
              {
                "const": "worker_lease_expired",
                "type": "string"
              },
              {
                "const": "execution_deadline",
                "type": "string"
              },
              {
                "const": "attempt_timeout",
                "type": "string"
              },
              {
                "const": "insufficient_evidence",
                "type": "string"
              },
              {
                "const": "oracle_uncertain",
                "type": "string"
              },
              {
                "const": "retry_unsafe_external_effect",
                "type": "string"
              },
              {
                "const": "user_cancelled",
                "type": "string"
              },
              {
                "const": "deadline_cancelled",
                "type": "string"
              },
              {
                "const": "tunnel_lost",
                "type": "string"
              },
              {
                "const": "artifact_limit_exceeded",
                "type": "string"
              },
              {
                "const": "storage_unavailable",
                "type": "string"
              },
              {
                "const": "artifact_expired",
                "type": "string"
              },
              {
                "const": "redaction_failed",
                "type": "string"
              },
              {
                "const": "budget_exhausted",
                "type": "string"
              },
              {
                "const": "quota_exceeded",
                "type": "string"
              },
              {
                "const": "schedule_misfire",
                "type": "string"
              },
              {
                "const": "schedule_overlap",
                "type": "string"
              },
              {
                "const": "owner_revoked",
                "type": "string"
              },
              {
                "const": "cleanup_failed",
                "type": "string"
              },
              {
                "const": "cleanup_inconclusive",
                "type": "string"
              },
              {
                "const": "optional_step_skipped",
                "type": "string"
              },
              {
                "const": "stopped_after_failure",
                "type": "string"
              },
              {
                "const": "cancelled_before_step",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "commit": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregate": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "counts",
        "gate"
      ],
      "properties": {
        "counts": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "passed",
            "failed",
            "blocked",
            "cancelled",
            "inconclusive",
            "inFlight"
          ],
          "properties": {
            "passed": {
              "minimum": 0,
              "type": "integer"
            },
            "failed": {
              "minimum": 0,
              "type": "integer"
            },
            "blocked": {
              "minimum": 0,
              "type": "integer"
            },
            "cancelled": {
              "minimum": 0,
              "type": "integer"
            },
            "inconclusive": {
              "minimum": 0,
              "type": "integer"
            },
            "inFlight": {
              "minimum": 0,
              "type": "integer"
            }
          }
        },
        "gate": {
          "anyOf": [
            {
              "const": "pending",
              "type": "string"
            },
            {
              "const": "passed",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "not_applicable",
              "type": "string"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:BatchRun",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
