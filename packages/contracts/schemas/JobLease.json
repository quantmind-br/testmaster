{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "queue",
    "resourceId",
    "leaseExpiresAt",
    "fence",
    "attempts",
    "availableAt"
  ],
  "properties": {
    "id": {
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "queue": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "resourceId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "leaseExpiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fence": {
      "minimum": 0,
      "type": "integer"
    },
    "attempts": {
      "minimum": 0,
      "type": "integer"
    },
    "availableAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:JobLease",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
