{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "name",
    "publicOrigin",
    "redirectUrl"
  ],
  "properties": {
    "name": {
      "minLength": 3,
      "maxLength": 34,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*$",
      "type": "string"
    },
    "publicOrigin": {
      "minLength": 8,
      "maxLength": 200,
      "type": "string"
    },
    "redirectUrl": {
      "minLength": 8,
      "maxLength": 300,
      "type": "string"
    },
    "allowAgentPullRequests": {
      "type": "boolean"
    },
    "organization": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:GithubManifestInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
