{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "comparability",
    "reasons",
    "differences",
    "nextCursor",
    "comparisonIdentity"
  ],
  "properties": {
    "comparability": {
      "anyOf": [
        {
          "const": "comparable",
          "type": "string"
        },
        {
          "const": "partially_comparable",
          "type": "string"
        },
        {
          "const": "incomparable",
          "type": "string"
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "differences": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "left",
          "right"
        ],
        "properties": {
          "field": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "left": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/T0"
                }
              },
              {
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {
                    "$ref": "#/$defs/T0"
                  }
                }
              }
            ]
          },
          "right": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/T0"
                }
              },
              {
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {
                    "$ref": "#/$defs/T0"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "comparisonIdentity": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$defs": {
    "T0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T0"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/T0"
            }
          }
        }
      ]
    }
  },
  "$id": "urn:testmaster:ComparisonResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
