{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "authorizationId",
    "authorizeUrl",
    "redirectUri",
    "expiresAt"
  ],
  "properties": {
    "authorizationId": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "authorizeUrl": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
    },
    "redirectUri": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AuthAuthorization",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
