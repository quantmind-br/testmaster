{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "projectId",
    "checked",
    "links"
  ],
  "properties": {
    "projectId": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "checked": {
      "minimum": 0,
      "type": "integer"
    },
    "links": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "syncState",
          "externalStatus",
          "externalStatusCategory"
        ],
        "properties": {
          "id": {
            "pattern": "^isl_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "syncState": {
            "anyOf": [
              {
                "const": "ok",
                "type": "string"
              },
              {
                "const": "deleted",
                "type": "string"
              },
              {
                "const": "conflict",
                "type": "string"
              },
              {
                "const": "revoked",
                "type": "string"
              }
            ]
          },
          "externalStatus": {
            "anyOf": [
              {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "externalStatusCategory": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "const": "open",
                    "type": "string"
                  },
                  {
                    "const": "closed",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:IssueLinkSyncReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
