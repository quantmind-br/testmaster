{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "action",
    "reason"
  ],
  "properties": {
    "action": {
      "anyOf": [
        {
          "const": "pause",
          "type": "string"
        },
        {
          "const": "drain",
          "type": "string"
        },
        {
          "const": "resume",
          "type": "string"
        }
      ]
    },
    "reason": {
      "minLength": 1,
      "maxLength": 2000,
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AdmissionInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
