{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "runId",
    "number",
    "workerId",
    "phase",
    "startedAt",
    "endedAt",
    "outcome",
    "kind",
    "policy",
    "retry",
    "createdAt"
  ],
  "properties": {
    "id": {
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "number": {
      "minimum": 1,
      "type": "integer"
    },
    "workerId": {
      "anyOf": [
        {
          "pattern": "^wrk_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "preparing",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "collecting",
          "type": "string"
        },
        {
          "const": "analyzing",
          "type": "string"
        },
        {
          "const": "completed",
          "type": "string"
        }
      ]
    },
    "startedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "endedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "passed",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            },
            {
              "const": "cancelled",
              "type": "string"
            },
            {
              "const": "inconclusive",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "const": "initial",
          "type": "string"
        },
        {
          "const": "retry",
          "type": "string"
        }
      ]
    },
    "policy": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "maxAttempts"
      ],
      "properties": {
        "maxAttempts": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "retry": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "previousAttemptId",
            "previousOutcome",
            "category",
            "reasonCode"
          ],
          "properties": {
            "previousAttemptId": {
              "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "previousOutcome": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "const": "passed",
                      "type": "string"
                    },
                    {
                      "const": "failed",
                      "type": "string"
                    },
                    {
                      "const": "blocked",
                      "type": "string"
                    },
                    {
                      "const": "cancelled",
                      "type": "string"
                    },
                    {
                      "const": "inconclusive",
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "category": {
              "anyOf": [
                {
                  "const": "infrastructure",
                  "type": "string"
                },
                {
                  "const": "diagnostic",
                  "type": "string"
                }
              ]
            },
            "reasonCode": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "const": "assertions_satisfied",
                      "type": "string"
                    },
                    {
                      "const": "assertion_mismatch",
                      "type": "string"
                    },
                    {
                      "const": "assertion_timeout",
                      "type": "string"
                    },
                    {
                      "const": "missing_secret",
                      "type": "string"
                    },
                    {
                      "const": "actor_revoked",
                      "type": "string"
                    },
                    {
                      "const": "credential_revoked",
                      "type": "string"
                    },
                    {
                      "const": "manual_auth_required",
                      "type": "string"
                    },
                    {
                      "const": "auth_checkpoint_expired",
                      "type": "string"
                    },
                    {
                      "const": "upstream_failed",
                      "type": "string"
                    },
                    {
                      "const": "dependency_cycle",
                      "type": "string"
                    },
                    {
                      "const": "ambiguous_producer",
                      "type": "string"
                    },
                    {
                      "const": "unsupported_capability",
                      "type": "string"
                    },
                    {
                      "const": "security_precondition_failed",
                      "type": "string"
                    },
                    {
                      "const": "approval_required",
                      "type": "string"
                    },
                    {
                      "const": "egress_denied",
                      "type": "string"
                    },
                    {
                      "const": "visual_baseline_missing",
                      "type": "string"
                    },
                    {
                      "const": "visual_baseline_stale",
                      "type": "string"
                    },
                    {
                      "const": "visual_baseline_unsupported",
                      "type": "string"
                    },
                    {
                      "const": "property_schema_invalid",
                      "type": "string"
                    },
                    {
                      "const": "property_dependency_missing",
                      "type": "string"
                    },
                    {
                      "const": "worker_lost",
                      "type": "string"
                    },
                    {
                      "const": "worker_lease_expired",
                      "type": "string"
                    },
                    {
                      "const": "execution_deadline",
                      "type": "string"
                    },
                    {
                      "const": "attempt_timeout",
                      "type": "string"
                    },
                    {
                      "const": "insufficient_evidence",
                      "type": "string"
                    },
                    {
                      "const": "oracle_uncertain",
                      "type": "string"
                    },
                    {
                      "const": "retry_unsafe_external_effect",
                      "type": "string"
                    },
                    {
                      "const": "user_cancelled",
                      "type": "string"
                    },
                    {
                      "const": "deadline_cancelled",
                      "type": "string"
                    },
                    {
                      "const": "tunnel_lost",
                      "type": "string"
                    },
                    {
                      "const": "artifact_limit_exceeded",
                      "type": "string"
                    },
                    {
                      "const": "storage_unavailable",
                      "type": "string"
                    },
                    {
                      "const": "artifact_expired",
                      "type": "string"
                    },
                    {
                      "const": "redaction_failed",
                      "type": "string"
                    },
                    {
                      "const": "evidence_incomplete",
                      "type": "string"
                    },
                    {
                      "const": "budget_exhausted",
                      "type": "string"
                    },
                    {
                      "const": "quota_exceeded",
                      "type": "string"
                    },
                    {
                      "const": "schedule_misfire",
                      "type": "string"
                    },
                    {
                      "const": "schedule_overlap",
                      "type": "string"
                    },
                    {
                      "const": "owner_revoked",
                      "type": "string"
                    },
                    {
                      "const": "already_passed_once",
                      "type": "string"
                    },
                    {
                      "const": "cleanup_failed",
                      "type": "string"
                    },
                    {
                      "const": "cleanup_inconclusive",
                      "type": "string"
                    },
                    {
                      "const": "optional_step_skipped",
                      "type": "string"
                    },
                    {
                      "const": "stopped_after_failure",
                      "type": "string"
                    },
                    {
                      "const": "cancelled_before_step",
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "const": "",
          "type": "string"
        }
      ]
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:AttemptListItem",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
