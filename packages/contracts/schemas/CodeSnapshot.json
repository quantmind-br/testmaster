{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "repoRef",
    "baseSha",
    "headSha",
    "dirtyHash",
    "manifestHash",
    "excludes"
  ],
  "properties": {
    "id": {
      "pattern": "^csp_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "repoRef": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "baseSha": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "headSha": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dirtyHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "excludes": {
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "skippedFiles": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:CodeSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
