{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "batchId",
    "studyIds",
    "testId",
    "revisionId",
    "environmentRevisionId",
    "identityHash",
    "window",
    "counts",
    "failureRate",
    "wilson95",
    "zeroFailureUpper95",
    "classification",
    "runIds",
    "failureCauses",
    "limitations",
    "incompatible"
  ],
  "properties": {
    "batchId": {
      "pattern": "^bat_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "studyIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "pattern": "^bat_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "testId": {
      "pattern": "^tst_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "revisionId": {
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "environmentRevisionId": {
      "pattern": "^evr_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "identityHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "window": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "counts": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "nPlanned",
        "nPass",
        "nFail",
        "nBlocked",
        "nCancelled",
        "nInconclusive",
        "nValid",
        "nInFlight"
      ],
      "properties": {
        "nPlanned": {
          "minimum": 0,
          "type": "integer"
        },
        "nPass": {
          "minimum": 0,
          "type": "integer"
        },
        "nFail": {
          "minimum": 0,
          "type": "integer"
        },
        "nBlocked": {
          "minimum": 0,
          "type": "integer"
        },
        "nCancelled": {
          "minimum": 0,
          "type": "integer"
        },
        "nInconclusive": {
          "minimum": 0,
          "type": "integer"
        },
        "nValid": {
          "minimum": 0,
          "type": "integer"
        },
        "nInFlight": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "failureRate": {
      "anyOf": [
        {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "wilson95": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "low",
            "high"
          ],
          "properties": {
            "low": {
              "minimum": 0,
              "maximum": 1,
              "type": "number"
            },
            "high": {
              "minimum": 0,
              "maximum": 1,
              "type": "number"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "zeroFailureUpper95": {
      "anyOf": [
        {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "anyOf": [
        {
          "const": "insufficient_data",
          "type": "string"
        },
        {
          "const": "passing_observed",
          "type": "string"
        },
        {
          "const": "deterministic_failure",
          "type": "string"
        },
        {
          "const": "suspected_flaky",
          "type": "string"
        },
        {
          "const": "confirmed_flaky",
          "type": "string"
        },
        {
          "const": "unstable_infrastructure",
          "type": "string"
        }
      ]
    },
    "runIds": {
      "type": "array",
      "items": {
        "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "failureCauses": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "runId",
          "attemptId",
          "stepId",
          "category",
          "reasonCode",
          "contentHash"
        ],
        "properties": {
          "runId": {
            "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "attemptId": {
            "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "stepId": {
            "anyOf": [
              {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "const": "environment",
                "type": "string"
              },
              {
                "const": "product_or_contract",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "const": "assertions_satisfied",
                "type": "string"
              },
              {
                "const": "assertion_mismatch",
                "type": "string"
              },
              {
                "const": "assertion_timeout",
                "type": "string"
              },
              {
                "const": "missing_secret",
                "type": "string"
              },
              {
                "const": "credential_revoked",
                "type": "string"
              },
              {
                "const": "manual_auth_required",
                "type": "string"
              },
              {
                "const": "auth_checkpoint_expired",
                "type": "string"
              },
              {
                "const": "upstream_failed",
                "type": "string"
              },
              {
                "const": "dependency_cycle",
                "type": "string"
              },
              {
                "const": "ambiguous_producer",
                "type": "string"
              },
              {
                "const": "unsupported_capability",
                "type": "string"
              },
              {
                "const": "security_precondition_failed",
                "type": "string"
              },
              {
                "const": "approval_required",
                "type": "string"
              },
              {
                "const": "egress_denied",
                "type": "string"
              },
              {
                "const": "worker_lost",
                "type": "string"
              },
              {
                "const": "worker_lease_expired",
                "type": "string"
              },
              {
                "const": "execution_deadline",
                "type": "string"
              },
              {
                "const": "attempt_timeout",
                "type": "string"
              },
              {
                "const": "insufficient_evidence",
                "type": "string"
              },
              {
                "const": "oracle_uncertain",
                "type": "string"
              },
              {
                "const": "retry_unsafe_external_effect",
                "type": "string"
              },
              {
                "const": "user_cancelled",
                "type": "string"
              },
              {
                "const": "deadline_cancelled",
                "type": "string"
              },
              {
                "const": "tunnel_lost",
                "type": "string"
              },
              {
                "const": "artifact_limit_exceeded",
                "type": "string"
              },
              {
                "const": "storage_unavailable",
                "type": "string"
              },
              {
                "const": "artifact_expired",
                "type": "string"
              },
              {
                "const": "redaction_failed",
                "type": "string"
              },
              {
                "const": "budget_exhausted",
                "type": "string"
              },
              {
                "const": "quota_exceeded",
                "type": "string"
              },
              {
                "const": "schedule_misfire",
                "type": "string"
              },
              {
                "const": "schedule_overlap",
                "type": "string"
              },
              {
                "const": "owner_revoked",
                "type": "string"
              },
              {
                "const": "cleanup_failed",
                "type": "string"
              },
              {
                "const": "cleanup_inconclusive",
                "type": "string"
              },
              {
                "const": "optional_step_skipped",
                "type": "string"
              },
              {
                "const": "stopped_after_failure",
                "type": "string"
              },
              {
                "const": "cancelled_before_step",
                "type": "string"
              }
            ]
          },
          "contentHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "maxLength": 8000,
        "type": "string"
      }
    },
    "incompatible": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "batchId",
          "reasons"
        ],
        "properties": {
          "batchId": {
            "pattern": "^bat_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:FlakeStudyReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
