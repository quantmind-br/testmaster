{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "counts",
    "rates",
    "exclusions",
    "blockedReasons",
    "retryPolicy"
  ],
  "properties": {
    "counts": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "rates": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "numerator",
            "denominator",
            "denominatorState",
            "state",
            "value",
            "definition",
            "scope"
          ],
          "properties": {
            "numerator": {
              "minimum": 0,
              "type": "integer"
            },
            "denominator": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "denominatorState": {
              "anyOf": [
                {
                  "const": "known",
                  "type": "string"
                },
                {
                  "const": "unknown",
                  "type": "string"
                }
              ]
            },
            "state": {
              "anyOf": [
                {
                  "const": "available",
                  "type": "string"
                },
                {
                  "const": "notApplicable",
                  "type": "string"
                },
                {
                  "const": "insufficientData",
                  "type": "string"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 1,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "definition": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      }
    },
    "exclusions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "blockedReasons": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "retryPolicy": {
      "type": "string"
    }
  },
  "$defs": {},
  "$id": "urn:testmaster:ExecutionMetrics",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
