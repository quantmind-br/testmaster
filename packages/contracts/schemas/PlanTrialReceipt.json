{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "batchId",
    "batchVersion",
    "environmentId",
    "trials"
  ],
  "properties": {
    "batchId": {
      "pattern": "^pbt_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "batchVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "environmentId": {
      "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "trials": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposalId",
          "proposalVersion",
          "planName",
          "tried",
          "failedSteps"
        ],
        "properties": {
          "proposalId": {
            "pattern": "^pro_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "proposalVersion": {
            "minimum": 1,
            "type": "integer"
          },
          "planName": {
            "minLength": 1,
            "maxLength": 200,
            "type": "string"
          },
          "tried": {
            "type": "boolean"
          },
          "reason": {
            "maxLength": 8000,
            "type": "string"
          },
          "runId": {
            "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "const": "passed",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "type": "string"
                  },
                  {
                    "const": "blocked",
                    "type": "string"
                  },
                  {
                    "const": "cancelled",
                    "type": "string"
                  },
                  {
                    "const": "inconclusive",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "gate": {
            "anyOf": [
              {
                "const": "pending",
                "type": "string"
              },
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              },
              {
                "const": "not_applicable",
                "type": "string"
              }
            ]
          },
          "cleanupOutcome": {
            "anyOf": [
              {
                "const": "not_required",
                "type": "string"
              },
              {
                "const": "pending",
                "type": "string"
              },
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              },
              {
                "const": "inconclusive",
                "type": "string"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "const": "assertions_satisfied",
                "type": "string"
              },
              {
                "const": "assertion_mismatch",
                "type": "string"
              },
              {
                "const": "assertion_timeout",
                "type": "string"
              },
              {
