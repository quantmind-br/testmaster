{
  "defaultProfile": "local",
  "profiles": {
    "local": {
      "config": {
        "schemaVersion": "1.0.0"
      },
      "modelProviders": [
        {
          "id": "quantforge",
          "kind": "openai-compatible",
          "baseUrl": "https://api.quantforge.com.br/v1",
