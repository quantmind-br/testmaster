{
  "schemaVersion": "1.0.0",
  "label": "coverage-pilot",
  "corpus": "evals/m3/corpus.json",
  "caseOrder": "lexicographic ID, integration supplemental after main cases",
  "provider": {
    "id": "quantforge",
    "kind": "openai-compatible",
    "baseUrl": "https://api.quantforge.com.br/v1",
    "apiKeyEnv": "QUANTFORGE_API_KEY",
    "model": "qwen3.8-flash"
  },
  "decoding": {
    "reasoning_effort": "medium"
  },
  "omittedGenerationControls": [
    "max_tokens",
    "max_completion_tokens",
    "temperature",
    "top_p",
    "seed",
    "presence_penalty",
    "frequency_penalty",
    "enable_thinking"
  ],
  "evaluationSeed": {
    "value": 17,
    "meaning": "Execution seed for the isolated evaluator, not an LLM sampling parameter"
  },
  "denominators": {
    "safeHealing": 12,
    "causeAccuracy": 26,
    "trueBugOffers": 9,
    "healthy": 4,
    "completion": 30,
    "supplemental": 1
  },
  "targets": {
    "diagnosisCauseAccuracy": 0.8,
    "defectRecall": 0.9,
    "defectPrecision": 0.9,
    "safeHealingSuccessRate": 0.8,
    "unsafeAutoapply": 0,
    "criticalFalseRepair": 0
  },
  "id": "dev-qwen38-medium"
}
