{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/*.d.ts",
      "!**/schemas/*.json",
      "!**/openapi.json",
      "!python",
      "!.testmaster",
      "!containers/seccomp",
      "!containers/seccomp_profile.json",
      "!validation/results",
      "!evals/results",
      "!evals/rounds/**/preregistration.json",
      "!evals/rounds/**/controls",
      "!evals/rounds/**/policy-probes",
      "!evals/rounds/**/started.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
