# Copy to .env next to compose.yaml and adjust. Every path is on the host; the data and key
# directories are mounted at the same absolute path inside the server container because worker
# sandboxes bind-mount host paths.
TESTMASTER_RUNTIME_DIR=/home/operator/testmaster          # built checkout (pnpm install && pnpm build)
TESTMASTER_CONFIG=/srv/testmaster/server.json             # mode 0600, from server.example.json
TESTMASTER_DATA_DIR=/srv/testmaster/evidence              # evidence volume (operator-encrypted)
TESTMASTER_KEY_DIR=/srv/testmaster/keys                   # master.key, backup.key (0600)
TESTMASTER_BACKUP_DIR=/srv/testmaster/backups
TESTMASTER_PG_DATA=/srv/testmaster/pgdata                 # database volume (operator-encrypted)
TESTMASTER_TLS_DIR=/srv/testmaster/tls                    # output of gen-tls.sh
TESTMASTER_PG_ADMIN_PASSWORD_FILE=/srv/testmaster/pg-admin.password
TESTMASTER_DB_PASSWORD_FILE=/srv/testmaster/db.password   # application role password, mode 0600
TESTMASTER_PG_PORT=55432                                  # published on 127.0.0.1 only
TESTMASTER_PUBLIC_HOST=testmaster.example.com             # name Caddy issues its certificate for
TESTMASTER_PUBLIC_PORT=8443
TESTMASTER_CONTAINER_USER=0:0                             # rootless daemon; use `id -u`:`id -g` on rootful
