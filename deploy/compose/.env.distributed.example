# Copy to .env next to compose.distributed.yaml and adjust (docker compose -f compose.distributed.yaml
# reads it). Every path is on the host. Secret files are mode 0600, owned by the operator.
TESTMASTER_RUNTIME_DIR=/home/operator/testmaster          # built checkout (pnpm install && pnpm build)
TESTMASTER_CONFIG=/srv/testmaster/controller-1.json       # from server.distributed.example.json, internalOrigin http://server:7331
TESTMASTER_CONFIG_2=/srv/testmaster/controller-2.json     # the same, internalOrigin http://server-2:7331
TESTMASTER_STAGING_DIR=/srv/testmaster/staging-1          # per-controller scratch, never shared
TESTMASTER_STAGING_DIR_2=/srv/testmaster/staging-2
TESTMASTER_KEY_DIR=/srv/testmaster/keys                   # master.key only (0600); the backup key stays on the backup agent's host
TESTMASTER_PG_DATA=/srv/testmaster/pgdata                 # database volume (operator-encrypted)
TESTMASTER_MINIO_DATA=/srv/testmaster/minio               # object store volume (operator-encrypted)
TESTMASTER_TLS_DIR=/srv/testmaster/tls                    # output of gen-tls.sh (CA, PostgreSQL and MinIO certificates)
TESTMASTER_PG_ADMIN_PASSWORD_FILE=/srv/testmaster/pg-admin.password
TESTMASTER_DB_PASSWORD_FILE=/srv/testmaster/db.password   # application role password
TESTMASTER_MINIO_ROOT_USER_FILE=/srv/testmaster/minio-root-user
TESTMASTER_MINIO_ROOT_PASSWORD_FILE=/srv/testmaster/minio-root-password
TESTMASTER_S3_EVIDENCE_ID_FILE=/srv/testmaster/s3-evidence-access-key-id           # the controllers' identity
TESTMASTER_S3_EVIDENCE_SECRET_FILE=/srv/testmaster/s3-evidence-secret-access-key
TESTMASTER_S3_BACKUP_ID_FILE=/srv/testmaster-backup/s3-access-key-id               # the backup agent's identity; only minio-init reads it here
TESTMASTER_S3_BACKUP_SECRET_FILE=/srv/testmaster-backup/s3-secret-access-key
TESTMASTER_S3_BUCKET=testmaster-evidence
TESTMASTER_S3_BACKUP_BUCKET=testmaster-backups
TESTMASTER_BACKUP_LOCK_DAYS=90                            # COMPLIANCE retention: cannot be shortened or undone by anyone; at least your oldest kept backup
TESTMASTER_PG_PORT=55432                                  # published on 127.0.0.1 only
TESTMASTER_S3_PORT=59000                                  # published on 127.0.0.1 only
TESTMASTER_CONTROLLER_PORT=17331                          # each controller, published on 127.0.0.1 only
TESTMASTER_CONTROLLER_PORT_2=17332
TESTMASTER_PUBLIC_HOST=testmaster.example.com             # name Caddy issues its certificate for
TESTMASTER_PUBLIC_PORT=8443
TESTMASTER_CONTAINER_USER=1000:1000                       # `id -u`:`id -g` on a rootful daemon; 0:0 on a rootless one
